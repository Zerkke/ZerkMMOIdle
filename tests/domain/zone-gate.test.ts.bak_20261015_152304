import { describe, it, expect } from 'vitest';
import { checkZoneAccess } from '../../src/domain/zones';

const zonaVazia = { requiredAp: 0, requiredDp: 0 };
const zonaFerro = { requiredAp: 60, requiredDp: 35 };
const zonaDragao = { requiredAp: 180, requiredDp: 120 };

describe('checkZoneAccess — gate AP/DP', () => {
  it('zona sem requisito: sempre ok', () => {
    const r = checkZoneAccess(0, 0, zonaVazia);
    expect(r.status).toBe('ok');
  });

  it('AP abaixo do requisito: blocked', () => {
    const r = checkZoneAccess(30, 100, zonaFerro);
    expect(r.status).toBe('blocked');
    expect(r.reason).toContain('AP');
  });

  it('DP abaixo do requisito: blocked', () => {
    const r = checkZoneAccess(100, 10, zonaFerro);
    expect(r.status).toBe('blocked');
    expect(r.reason).toContain('DP');
  });

  it('AP e DP abaixo: reason mostra ambos', () => {
    const r = checkZoneAccess(10, 5, zonaFerro);
    expect(r.status).toBe('blocked');
    expect(r.reason).toContain('AP');
    expect(r.reason).toContain('DP');
  });

  it('AP e DP exatamente iguais ao requisito: ok', () => {
    const r = checkZoneAccess(60, 35, zonaFerro);
    expect(r.status).toBe('ok');
  });

  it('1.5x do requisito: bonus', () => {
    const r = checkZoneAccess(90, 53, zonaFerro);
    expect(r.status).toBe('bonus');
  });

  it('AP 1.5x mas DP normal: ok (nao bonus)', () => {
    const r = checkZoneAccess(90, 36, zonaFerro);
    expect(r.status).toBe('ok');
  });

  it('zona end-game bloqueia personagem fraco', () => {
    const r = checkZoneAccess(39, 40, zonaDragao);
    expect(r.status).toBe('blocked');
  });

  it('personagem bem equipado passa zona end-game com bonus', () => {
    const r = checkZoneAccess(300, 200, zonaDragao);
    expect(r.status).toBe('bonus');
  });
});