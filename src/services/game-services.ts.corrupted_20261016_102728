  getCurrentPlayerHp(): number { return Math.round(this.combatState?.playerHp ?? this.character.hp); }
  getCurrentPlayerResource(): number { return Math.round(this.combatState?.playerResource ?? this.character.resource); }

  /* ==================== Inventario ==================== */

  addItem(itemId: ItemId, quantity: number): AddResult {
    const def = this.registry.getItem(itemId);
    if (!def) { this.emit({ type: 'notice', message: 'Item desconhecido: ' + itemId, level: 'error' }); return { added: 0, leftover: quantity }; }
    const dur = isTool(def) ? def.maxDurability : null;
    const result = this.inventory.add(itemId, quantity, def.maxStack, 0, dur);
    if (result.leftover > 0) this.emit({ type: 'notice', message: 'Inventario cheio.', level: 'warn' });
    if (result.added > 0) this.emit({ type: 'inventory-changed' });
    return result;
  }

  removeItem(itemId: ItemId, quantity: number): number {
    const r = this.inventory.remove(itemId, quantity);
    if (r.removed > 0) this.emit({ type: 'inventory-changed' });
    return r.removed;
  }

  splitSlot(slotIndex: number, quantity: number): boolean {
    const err = this.inventory.split(slotIndex, quantity);
    if (err) return false;
    this.emit({ type: 'inventory-changed' });
    return true;
  }

  moveSlot(fromIndex: number, toIndex: number): boolean {
    const err = this.inventory.move(fromIndex, toIndex);
    if (err) return false;
    this.emit({ type: 'inventory-changed' });
    return true;
  }

  /* ==================== Equipamento ==================== */

  equipFromInventory(slotIndex: number): boolean {
    const slot = this.inventory.list()[slotIndex];
    if (!slot) return false;
    const def = this.registry.getItem(slot.itemId);
    if (!def || !isEquippable(def)) return false;
    if (this.character.level < def.requiredLevel) { this.emit({ type: 'notice', message: 'Requer nivel ' + def.requiredLevel + '.', level: 'warn' }); return false; }
    const targetSlot = def.equipSlot;
    if (targetSlot === null) return false;
    const resolved = this.resolveSlot(targetSlot);
    const occupied = this.equipment.get(resolved);
    if (occupied) {
      const currentDef = this.registry.getItem(occupied.itemId);
      const leftover = this.inventory.add(occupied.itemId, 1, currentDef?.maxStack ?? 1, occupied.enhancementLevel, occupied.durability);
      if (leftover.leftover > 0) { this.emit({ type: 'notice', message: 'Sem espaco para desequipar.', level: 'error' }); return false; }
      this.equipment.unequip(resolved);
    }
    const removed = this.inventory.removeAt(slotIndex);
    if (!removed) { this.emit({ type: 'notice', message: 'Erro ao remover.', level: 'error' }); return false; }
    const err: EquipError | null = this.equipment.equip(resolved, makeStack(removed.itemId, 1, removed.enhancementLevel, removed.durability, removed.randomAttributes, removed.essences));
    if (err) { this.inventory.setAt(slotIndex, removed); return false; }
    this.clampPlayerStats();
    this.triggerTutorial({ kind: 'equip-slot', targetId: resolved, amount: 1 });
    this.triggerQuest({ kind: 'equip-slot', targetId: resolved, amount: 1 });
    this.emit({ type: 'equipment-changed' });
    this.emit({ type: 'inventory-changed' });
    return true;
  }

  unequipToInventory(slotId: EquipmentSlotId): boolean {
    const stack = this.equipment.get(slotId);
    if (!stack) return false;
    const def = this.registry.getItem(stack.itemId);
    const leftover = this.inventory.add(stack.itemId, 1, def?.maxStack ?? 1, stack.enhancementLevel, stack.durability);
    if (leftover.leftover > 0) { this.emit({ type: 'notice', message: 'Inventario cheio.', level: 'warn' }); return false; }
    this.equipment.unequip(slotId);
    this.clampPlayerStats();
    this.emit({ type: 'equipment-changed' });
    this.emit({ type: 'inventory-changed' });
    return true;
  }

  private resolveSlot(slotId: EquipmentSlotId): EquipmentSlotId {
    if (slotId === 'ring1' && this.equipment.get('ring1')) return 'ring2';
    if (slotId === 'earring1' && this.equipment.get('earring1')) return 'earring2';
    return slotId;
  }

  private clampPlayerStats(): void {
    const d = this.getDerivedStats();
    this.character = { ...this.character, hp: Math.min(this.character.hp, d.maxHp), resource: Math.min(this.character.resource, d.maxResource) };
  }

  private repairLegacyTools(): void {
    const invList = this.inventory.list();
    for (let i = 0; i < invList.length; i++) {
      const s = invList[i];
      if (!s) continue;
      const def = this.registry.getItem(s.itemId);
      if (!def || !isTool(def)) continue;
      if (s.durability === null) this.inventory.setAt(i, { ...s, durability: def.maxDurability });
    }
    for (const [slotId, stack] of this.equipment.list()) {
      const def = this.registry.getItem(stack.itemId);
      if (!def || !isTool(def)) continue;
      if (stack.durability === null) this.equipment.setSlot(slotId, { ...stack, durability: def.maxDurability });
    }
  }

  private ensureStartingTools(): void {
    const STARTING_TOOLS = ['item.tool.pickaxe', 'item.tool.axe', 'item.tool.sickle', 'item.tool.fishing-rod', 'item.tool.skin-knife'];
    let hasAnyTool = false;
    for (const stack of this.inventory.list()) {
      if (!stack) continue;
      const def = this.registry.getItem(stack.itemId);
      if (def && isTool(def)) { hasAnyTool = true; break; }
    }
    if (!hasAnyTool) {
      for (const stack of this.equipment.list().values()) {
        const def = this.registry.getItem(stack.itemId);
        if (def && isTool(def)) { hasAnyTool = true; break; }
      }
    }
    if (hasAnyTool) return;
    for (const id of STARTING_TOOLS) {
      const itemId = asItemId(id);
      const def = this.registry.getItem(itemId);
      if (!def) continue;
      this.inventory.add(itemId, 1, def.maxStack, 0, def.maxDurability);
    }
    this.emit({ type: 'notice', message: 'Ferramentas basicas restauradas.', level: 'info' });
    this.emit({ type: 'inventory-changed' });
  }

  private ensureStartingSeeds(): void {
    const STARTING_SEEDS = [
      { itemId: 'item.seed.wheat', qty: 6 },
      { itemId: 'item.seed.carrot', qty: 6 },
      { itemId: 'item.seed.herb', qty: 4 },
    ];
    let hasAnySeed = false;
    for (const stack of this.inventory.list()) {
      if (!stack) continue;
      const def = this.registry.getItem(stack.itemId);
      if (def && def.seedForNodeId !== null) { hasAnySeed = true; break; }
    }
    if (hasAnySeed) return;
    for (const s of STARTING_SEEDS) {
      const itemId = asItemId(s.itemId);
      const def = this.registry.getItem(itemId);
      if (!def) continue;
      this.inventory.add(itemId, s.qty, def.maxStack, 0);
    }
    this.emit({ type: 'notice', message: 'Sementes iniciais recebidas.', level: 'info' });
    this.emit({ type: 'inventory-changed' });
  }

  buySeed(itemId: ItemId, quantity: number): boolean {
    const SEED_PRICES: Record<string, number> = {
      'item.seed.wheat': 15,
      'item.seed.carrot': 18,
      'item.seed.herb': 25,
    };
    const price = SEED_PRICES[itemId as string];
    if (price === undefined) return false;
    const def = this.registry.getItem(itemId);
    if (!def) return false;
    const total = price * quantity;
    if (this.character.silver < total) {
      this.emit({ type: 'notice', message: 'Prata insuficiente.', level: 'warn' });
      return false;
    }
    const res = this.inventory.add(itemId, quantity, def.maxStack, 0);
    if (res.added === 0) {
      this.emit({ type: 'notice', message: 'Inventario cheio.', level: 'warn' });
      return false;
    }
    this.character = { ...this.character, silver: this.character.silver - total };
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'notice', message: 'Compradas ' + res.added + 'x ' + def.name + '.', level: 'info' });
    return true;
  }

  getSeedShop(): readonly { readonly itemId: ItemId; readonly name: string; readonly price: number }[] {
    const SEED_PRICES: Record<string, number> = {
      'item.seed.wheat': 15,
      'item.seed.carrot': 18,
      'item.seed.herb': 25,
    };
    const out: { itemId: ItemId; name: string; price: number }[] = [];
    for (const [id, price] of Object.entries(SEED_PRICES)) {
      const itemId = asItemId(id);
      const def = this.registry.getItem(itemId);
      if (def) out.push({ itemId, name: def.name, price });
    }
    return out;
  }

  /* ==================== Armazem ==================== */

  getWarehouse(): Inventory { return this.warehouse; }

  transferToWarehouse(slotIndex: number, quantity: number): boolean {
    const slot = this.inventory.list()[slotIndex];
    if (!slot) return false;
    if (!Number.isInteger(quantity) || quantity <= 0 || quantity > slot.quantity) return false;
    const def = this.registry.getItem(slot.itemId);
    if (!def) return false;
    const test = this.warehouse.add(slot.itemId, quantity, def.maxStack, slot.enhancementLevel, slot.durability);
    if (test.added !== quantity) {
      this.warehouse.remove(slot.itemId, test.added, slot.enhancementLevel);
      this.emit({ type: 'notice', message: 'Armazem cheio.', level: 'warn' });
      return false;
    }
    this.inventory.removeAt(slotIndex);
    if (slot.quantity > quantity) this.inventory.setAt(slotIndex, { ...slot, quantity: slot.quantity - quantity });
    this.ledger.record('warehouse', 0, [{ itemId: slot.itemId, delta: -quantity }], 'Para armazem: ' + def.name + ' x' + quantity, Date.now());
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'notice', message: 'Movido para armazem: ' + def.name + ' x' + quantity + '.', level: 'info' });
    return true;
  }

  transferFromWarehouse(slotIndex: number, quantity: number): boolean {
    const slot = this.warehouse.list()[slotIndex];
    if (!slot) return false;
    if (!Number.isInteger(quantity) || quantity <= 0 || quantity > slot.quantity) return false;
    const def = this.registry.getItem(slot.itemId);
    if (!def) return false;
    const test = this.inventory.add(slot.itemId, quantity, def.maxStack, slot.enhancementLevel, slot.durability);
    if (test.added !== quantity) {
      this.inventory.remove(slot.itemId, test.added, slot.enhancementLevel);
      this.emit({ type: 'notice', message: 'Inventario cheio.', level: 'warn' });
      return false;
    }
    this.warehouse.removeAt(slotIndex);
    if (slot.quantity > quantity) this.warehouse.setAt(slotIndex, { ...slot, quantity: slot.quantity - quantity });
    this.ledger.record('warehouse', 0, [{ itemId: slot.itemId, delta: quantity }], 'Do armazem: ' + def.name + ' x' + quantity, Date.now());
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'notice', message: 'Retirado do armazem: ' + def.name + ' x' + quantity + '.', level: 'info' });
    return true;
  }

  /* ==================== Loja NPC ==================== */

  getShopCatalog(): readonly NpcShopEntry[] { return NPC_SHOP; }

  sellToNpc(slotIndex: number, quantity: number): boolean {
    const slot = this.inventory.list()[slotIndex];
    if (!slot) return false;
    if (!Number.isInteger(quantity) || quantity <= 0 || quantity > slot.quantity) return false;
    const def = this.registry.getItem(slot.itemId);
    if (!def) return false;
    const unitPrice = npcBuybackPrice(def.sellPrice);
    const totalSilver = unitPrice * quantity;
    const removed = this.inventory.remove(slot.itemId, quantity, slot.enhancementLevel);
    if (removed.removed !== quantity) return false;
    this.character = addSilver(this.character, totalSilver);
    this.ledger.record('sell', totalSilver, [{ itemId: slot.itemId, delta: -quantity }], 'Venda: ' + def.name + ' x' + quantity, Date.now());
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'notice', message: 'Vendido: ' + def.name + ' x' + quantity + ' (+' + totalSilver + ' prata).', level: 'info' });
    return true;
  }

  buyFromNpc(itemId: ItemId, quantity: number): boolean {
    if (!Number.isInteger(quantity) || quantity <= 0) return false;
    const entry = findShopEntry(itemId);
    if (!entry) {
      this.emit({ type: 'notice', message: 'Item nao disponivel na loja.', level: 'warn' });
      return false;
    }
    const def = this.registry.getItem(itemId);
    if (!def) return false;
    const total = entry.buyPrice * quantity;
    if (this.character.silver < total) {
      this.emit({ type: 'notice', message: 'Prata insuficiente.', level: 'warn' });
      return false;
    }
    const dur = isTool(def) ? def.maxDurability : null;
    const added = this.inventory.add(itemId, quantity, def.maxStack, 0, dur);
    if (added.added !== quantity) {
      this.inventory.remove(itemId, added.added);
      this.emit({ type: 'notice', message: 'Inventario cheio.', level: 'warn' });
      return false;
    }
    this.character = addSilver(this.character, -total);
    this.triggerTutorial({ kind: 'buy-item', targetId: itemId as string, amount: 1 });
    this.triggerQuest({ kind: 'buy-item', targetId: itemId as string, amount: 1 });
    this.ledger.record('buy', -total, [{ itemId, delta: quantity }], 'Compra: ' + def.name + ' x' + quantity, Date.now());
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'notice', message: 'Comprado: ' + def.name + ' x' + quantity + ' (-' + total + ' prata).', level: 'info' });
    return true;
  }

