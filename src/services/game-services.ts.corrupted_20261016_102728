  /** Calcula o custo de um servico para o estado atual. */
  getServiceCost(serviceId: string): number | null {
    const svc = this.findServiceById(serviceId);
    if (!svc) return null;
    if (svc.kind === 'heal-hp') {
      const derived = this.getDerivedStats();
      const missing = Math.max(0, derived.maxHp - this.character.hp);
      return missing * svc.costPerUnit;
    }
    if (svc.kind === 'heal-resource') {
      const derived = this.getDerivedStats();
      const missing = Math.max(0, derived.maxResource - this.character.resource);
      return missing * svc.costPerUnit;
    }
    if (svc.kind === 'repair-tool') {
      const tool = this.equipment.get('tool');
      if (!tool || tool.durability === null) return null;
      const def = this.registry.getItem(tool.itemId);
      if (!def) return null;
      const missing = Math.max(0, def.maxDurability - tool.durability);
      return missing * svc.costPerUnit;
    }
    if (svc.kind === 'buy-item') return svc.costPerUnit;
    return null;
  }

  useService(serviceId: string): boolean {
    const svc = this.findServiceById(serviceId);
    if (!svc) { this.emit({ type: 'notice', message: 'Servico desconhecido.', level: 'warn' }); return false; }

    const cost = this.getServiceCost(serviceId);
    if (cost === null) { this.emit({ type: 'notice', message: 'Servico indisponivel.', level: 'warn' }); return false; }
    if (cost === 0) { this.emit({ type: 'notice', message: 'Nao precisas deste servico agora.', level: 'info' }); return false; }
    if (this.character.silver < cost) {
      this.emit({ type: 'notice', message: 'Prata insuficiente (' + cost + ').', level: 'warn' });
      return false;
    }

    // Aplicar efeito
    if (svc.kind === 'heal-hp') {
      const derived = this.getDerivedStats();
      this.character = { ...this.character, hp: derived.maxHp };
      this.ledger.record('buy', -cost, [], 'Servico: ' + svc.name, Date.now());
    } else if (svc.kind === 'heal-resource') {
      const derived = this.getDerivedStats();
      this.character = { ...this.character, resource: derived.maxResource };
      this.ledger.record('buy', -cost, [], 'Servico: ' + svc.name, Date.now());
    } else if (svc.kind === 'repair-tool') {
      const tool = this.equipment.get('tool');
      if (!tool) { this.emit({ type: 'notice', message: 'Sem ferramenta equipada.', level: 'warn' }); return false; }
      const def = this.registry.getItem(tool.itemId);
      if (!def) return false;
      this.equipment.setSlot('tool', { ...tool, durability: def.maxDurability });
      this.ledger.record('buy', -cost, [], 'Servico: ' + svc.name, Date.now());
    } else if (svc.kind === 'buy-item') {
      if (!svc.itemId) return false;
      const itemDef = this.registry.getItem(svc.itemId);
      if (!itemDef) return false;
      const dur = isTool(itemDef) ? itemDef.maxDurability : null;
      const res = this.inventory.add(svc.itemId, 1, itemDef.maxStack, 0, dur);
      if (res.added !== 1) {
        this.emit({ type: 'notice', message: 'Inventario cheio.', level: 'warn' });
        return false;
      }
      this.ledger.record('buy', -cost, [{ itemId: svc.itemId, delta: 1 }], 'Servico: ' + svc.name, Date.now());
    }

    this.character = addSilver(this.character, -cost);
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'equipment-changed' });
    this.emit({ type: 'notice', message: svc.name + ' (' + cost + ' prata)', level: 'info' });
    return true;
  }

  private findServiceById(serviceId: string): NpcServiceDefinition | null {
    for (const zone of this.registry.zones.values()) {
      const svcs = findServicesInZone(zone.id);
      for (const s of svcs) if (s.id === serviceId) return s;
    }
    return null;
  }
  /* ==================== Atributos ==================== */

  getBaseAttributes(): Attributes {
    const cls = this.registry.getClass(this.character.classId);
    return cls?.attributes ?? ZERO_ATTRIBUTES;
  }

  getEquipmentBonuses(): Attributes {
    let total = ZERO_ATTRIBUTES;
    for (const stack of this.equipment.list().values()) {
      const def = this.registry.getItem(stack.itemId);
      if (!def) continue;
      total = addAttributes(total, enhancedAttributes(def, stack.enhancementLevel));
    }
    return total;
  }

  getEquipmentPower(): PowerStats {
    let total = ZERO_POWER;
    for (const stack of this.equipment.list().values()) {
      const def = this.registry.getItem(stack.itemId);
      if (!def) continue;
      total = addPower(total, enhancedPower(def, stack.enhancementLevel));
    }
    return total;
  }

  /** Agrega bonus de melhoramento de todo o equipamento equipado. */
  getEquipmentEnhancementBonuses() {
    const entries: { item: import('../domain/content').ItemDefinition; level: number }[] = [];
    for (const stack of this.equipment.list().values()) {
      const def = this.registry.getItem(stack.itemId);
      if (!def) continue;
      entries.push({ item: def, level: stack.enhancementLevel });
    }
    return sumEnhancementBonuses(entries);
  }
  getTotalAttributes(): Attributes { return addAttributes(this.getBaseAttributes(), this.getEquipmentBonuses()); }
  getTotalPower(): PowerStats { return this.getEquipmentPower(); }
  getEquipmentRandomBonuses(): RandomBonusBundle {
    const rolls: (readonly RandomAttributeRoll[] | null)[] = [];
    for (const stack of this.equipment.list().values()) {
      rolls.push(stack.randomAttributes);
    }
    return sumRolls(rolls);
  }

  /**
   * FONTE UNICA de atributos derivados (AP, DP, attack, defense, HP, critico).
   * Ordem aplicada (Fase 16): base -> equip -> rolls -> buffs -> scaling -> floor.
   * Nao duplicar este calculo em nenhum outro modulo.
   */
  getDerivedStats() {
    const cls = this.registry.getClass(this.character.classId);
    const baseAttrs = this.getTotalAttributes();
    const basePower = this.getEquipmentPower();
    const rand = this.getEquipmentRandomBonuses();

    // Rolls de attack/defense entram via power (fonte unica de AP/DP bruto)
    const totalPower = {
      attackPower: basePower.attackPower + rand.attack,
      defensePower: basePower.defensePower + rand.defense,
    };

    const essBonus = this.getEssenceBonuses();
    const talentBonus = this.talentsService.getBonuses();
    const enh = this.getEquipmentEnhancementBonuses();
    const baseStats = deriveStats(baseAttrs, totalPower, {
      apScaling: cls?.apScaling ?? 1,
      dpScaling: cls?.dpScaling ?? 1,
      buffAp: this.buffModifier('ap-bonus'),
      buffDp: this.buffModifier('dp-bonus'),
      buffAttack: this.buffModifier('attack-power'),
      buffCritChance: this.buffModifier('crit-chance'),
      extraMaxHp: rand.maxHp + enh.hp,
      extraCritChance: rand.critChance + enh.critChance,
      essenceAp: essBonus.ap,
      essenceDp: essBonus.dp,
      essenceMaxHp: essBonus.maxHp,
      essenceCritChance: essBonus.critChance,
      essenceLifesteal: essBonus.lifesteal,
      enhancementHpRegen: enh.hpRegen,
      enhancementCritDamage: enh.critDamage,
      enhancementLifesteal: enh.lifesteal,
      enhancementDamageReduction: enh.damageReduction,
      talentAp: talentBonus.ap,
      talentDp: talentBonus.dp,
      talentMaxHp: talentBonus.maxHp,
      talentCritChance: talentBonus.critChance,
      talentCritDamage: talentBonus.critDamage,
      talentLifesteal: talentBonus.lifesteal,
      talentHpRegen: talentBonus.hpRegen,
      talentDamageReduction: talentBonus.damageReduction,
    });
    return this.specializationsService.applyModifiers(baseStats);
  }

  /** Breakdown de AP/DP para a UI. Cada componente aparece uma unica vez. */
  getPowerBreakdown(): {
    ap: { base: number; equipment: number; rolls: number; buffs: number; scaling: number; total: number };
    dp: { base: number; equipment: number; rolls: number; buffs: number; scaling: number; total: number };
  } {
    const cls = this.registry.getClass(this.character.classId);
    const baseAttrs = this.getTotalAttributes();
    const basePower = this.getEquipmentPower();
    const rand = this.getEquipmentRandomBonuses();
    const C = BALANCE.character;

    const baseAp = Math.floor(baseAttrs.strength * C.apFromStrength);
    const baseDp = Math.floor(baseAttrs.vitality * C.dpFromVitality);

    const equipAp = basePower.attackPower;
    const equipDp = basePower.defensePower;

    const rollsAp = rand.attack;
    const rollsDp = rand.defense;

    const buffsAp = this.buffModifier('ap-bonus');
    const buffsDp = this.buffModifier('dp-bonus');

    const apScaling = cls?.apScaling ?? 1;
    const dpScaling = cls?.dpScaling ?? 1;

    const rawAp = baseAp + equipAp + rollsAp + buffsAp;
    const rawDp = baseDp + equipDp + rollsDp + buffsDp;

    const totalAp = Math.max(0, Math.floor(rawAp * apScaling));
    const totalDp = Math.max(0, Math.floor(rawDp * dpScaling));

    return {
      ap: { base: baseAp, equipment: equipAp, rolls: rollsAp, buffs: buffsAp, scaling: apScaling, total: totalAp },
      dp: { base: baseDp, equipment: equipDp, rolls: rollsDp, buffs: buffsDp, scaling: dpScaling, total: totalDp },
    };
  }

  getCritDamageMultiplier(): number {
    return 1.5 + this.getEquipmentRandomBonuses().critDamage;
  }

  getExperienceBonus(): number {
    return this.getEquipmentRandomBonuses().bonusXp + this.talentsService.getBonuses().xpBonus;
  }

  getSilverBonus(): number {
    const rand = this.getEquipmentRandomBonuses();
    const ess = this.getEssenceBonuses();
    return rand.bonusSilver + ess.bonusSilver + this.talentsService.getBonuses().silverBonus;
  }

  getGatherYieldBonus(): number {
    return this.getEquipmentRandomBonuses().gatherYield + this.talentsService.getBonuses().gatherYield;
  }

  getPlayerSkills(): readonly SkillDefinition[] {
    const cls = this.registry.getClass(this.character.classId);
    if (!cls) return [];
    return cls.skillIds.map((id) => this.registry.getSkill(id))
      .filter((s): s is SkillDefinition => s !== undefined && s.requiredLevel <= this.character.level);
  }

  /* ==================== Melhoramentos ==================== */

  previewEnhancement(slotIndex: number, useProtection: boolean): EnhancementPreview | null {
    const slot = this.inventory.list()[slotIndex];
    if (!slot) return null;
    const def = this.registry.getItem(slot.itemId);
    if (!def || !def.enhanceable) return null;
    const category = this.inferCategory(def);
    const rule = this.registry.getEnhancementRule(category);
    if (!rule) return null;
    const currentLevel = slot.enhancementLevel;
    const targetLevel = currentLevel + 1;
    const alreadyMax = targetLevel > rule.maxLevel;
    if (alreadyMax) {
      return {
        itemId: slot.itemId, currentLevel, targetLevel: currentLevel,
        maxLevel: rule.maxLevel, successChance: 0,
        cost: { silver: 0, materials: [] }, failureOutcome: { kind: 'nothing' },
        canAfford: false, missingSilver: 0, missingMaterials: [], alreadyMax: true,
      };
    }
    const config = rule.levels.find((l) => l.targetLevel === targetLevel);
    if (!config) return null;
    const missingSilver = Math.max(0, config.cost.silver - this.character.silver);
    const missingMaterials = config.cost.materials
      .filter((m) => this.inventory.count(m.itemId) < m.quantity)
      .map((m) => ({ itemId: m.itemId, quantity: m.quantity - this.inventory.count(m.itemId) }));
    const canAfford = missingSilver === 0 && missingMaterials.length === 0;
    let failureOutcome = config.failureOutcome;
    if (useProtection && def.protectionItemId && this.inventory.count(def.protectionItemId) > 0 && config.failureOutcome.kind === 'destroy') {
      failureOutcome = { kind: 'nothing' };
    }
    return {
      itemId: slot.itemId, currentLevel, targetLevel, maxLevel: rule.maxLevel,
      successChance: config.successChance, cost: config.cost,
      failureOutcome, canAfford, missingSilver, missingMaterials, alreadyMax: false,
    };
  }

  enhanceFromInventorySlot(slotIndex: number, useProtection: boolean): EnhancementResult | null {
    const slot = this.inventory.list()[slotIndex];
    if (!slot) return null;
    const def = this.registry.getItem(slot.itemId);
    if (!def || !def.enhanceable) { this.emit({ type: 'notice', message: 'Item nao melhoravel.', level: 'warn' }); return null; }
    const category = this.inferCategory(def);
    const rule = this.registry.getEnhancementRule(category);
    if (!rule) return null;
    const wallet = {
      silver: () => this.character.silver,
      spendSilver: (amount: number): boolean => {
        if (this.character.silver < amount) return false;
        this.character = { ...this.character, silver: this.character.silver - amount };
        return true;
      },
    };
    const bag = {
      count: (itemId: ItemId) => this.inventory.count(itemId),
      consume: (itemId: ItemId, qty: number): boolean => this.inventory.remove(itemId, qty).removed === qty,
    };
    const protection = def.protectionItemId
      ? { has: (id: ItemId) => this.inventory.count(id) > 0, consume: (id: ItemId) => this.inventory.remove(id, 1).removed === 1 }
      : null;
    const result = attemptEnhancement({
      itemId: slot.itemId, currentLevel: slot.enhancementLevel, rule, wallet, bag,
      protectionItemId: useProtection ? def.protectionItemId : null,
      protection: useProtection ? protection : null,
      rng: this.rng, nowMs: Date.now(),
    });
    if (!result) { this.emit({ type: 'notice', message: 'Nao e possivel melhorar.', level: 'warn' }); return null; }
    if (result.destroyed) this.inventory.setAt(slotIndex, null);
    else if (result.newLevel !== slot.enhancementLevel) this.inventory.setAt(slotIndex, makeStack(slot.itemId, 1, result.newLevel, slot.durability, slot.randomAttributes, slot.essences));
    const hist: EnhancementHistoryEntry = {
      itemId: slot.itemId, previousLevel: result.previousLevel, attemptedLevel: result.previousLevel + 1,
      success: result.success, destroyed: result.destroyed, usedProtection: result.usedProtection, timestamp: result.timestamp,
    };
    this.enhancementHistory = pushHistory(this.enhancementHistory, hist, HISTORY_CAPACITY);
    if (result.success) this.triggerTutorial({ kind: 'enhance-level', targetId: null, amount: 1 });
    if (result.success) this.triggerQuest({ kind: 'enhance-level', targetId: null, amount: 1 });
    if (result.success) this.emit({ type: 'notice', message: 'Sucesso! +' + result.newLevel, level: 'info' });
    else if (result.destroyed) this.emit({ type: 'notice', message: 'Item destruido!', level: 'error' });
    else if (result.newLevel < result.previousLevel) this.emit({ type: 'notice', message: 'Falhou. Desceu para +' + result.newLevel + '.', level: 'warn' });
    else this.emit({ type: 'notice', message: 'Falhou.', level: 'warn' });
    this.emit({ type: 'enhancement-changed' });
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    return result;
  }

  private inferCategory(def: ItemDefinition): EnhancementCategory {
    if (def.category === 'weapon') return 'weapon';
    if (def.category === 'armor') return 'armor';
    if (def.category === 'accessory') return 'accessory';
    return 'tool';
  }

  grantSilverDebug(amount: number): void {
    this.character = addSilver(this.character, amount);
    this.emit({ type: 'character-changed' });
  }

  private ensureAllProfessions(): void {
    for (const p of this.registry.professions.values()) {
      if (!this.professionStates.has(p.id)) this.professionStates.set(p.id, newProfessionState());
    }
  }

  /* ==================== Persistencia ==================== */

  toSnapshot(now: number): SaveLatest {
    return {
      schemaVersion: 15,
      savedAt: now,
      character: characterToSnapshot(this.character),
      inventory: inventoryToSnapshot(this.inventory),
      warehouse: inventoryToSnapshot(this.warehouse),
      equipment: equipmentToSnapshot(this.equipment.list()),
      combat: this.combatState && this.currentZoneId && this.currentMonsterId
        ? combatStateToSnapshot(this.combatState, this.currentZoneId, this.currentMonsterId) : null,
      combatConfig: configToSnapshot(this.combatConfig),
      enhancementHistory: historyToSnapshot(this.enhancementHistory),
      professionStates: professionsToSnapshot(this.professionStates),
      activity: this.activity ? activityToSnapshot(this.activity) : null,
      buffs: this.buffs.toSnapshot().map((b) => ({ buffId: b.buffId as string, kind: b.kind, magnitude: b.magnitude, appliedAt: b.appliedAt, expiresAt: b.expiresAt })),
      farm: farmToSnapshot(this.farm),
      transactions: this.ledger.list().map((t) => ({
        id: t.id, category: t.category, silverDelta: t.silverDelta,
        itemDeltas: t.itemDeltas.map((d) => ({ itemId: d.itemId as string, delta: d.delta })),
        label: t.label, timestamp: t.timestamp,
      })),
      idleSetup: this.idleSetup ? idleSetupToSnapshot(this.idleSetup) : null,
      lastIdleReport: this.lastIdleReport ? idleReportToSnapshot(this.lastIdleReport) : null,
      tutorial: {
        entries: this.tutorial.entries.map((e) => ({ stepId: e.stepId, completed: e.completed, currentCount: e.currentCount, completedAt: e.completedAt })),
        rewardClaimed: Array.from(this.tutorial.rewardClaimed),
      },
      talents: {
        ranks: { ...this.talentsService.getState().ranks },
        respecCount: this.talentsService.getState().respecCount,
      },
      specialization: {
        active: this.specializationsService.getActiveId(),
        changeCount: this.specializationsService.getState().changeCount,
        lastChangeAt: this.specializationsService.getState().lastChangeAt,
      },
      dungeons: {
        active: this.dungeonsService.getState().active ? { ...this.dungeonsService.getState().active! } : null,
        results: Object.fromEntries(Object.entries(this.dungeonsService.getState().results).map(([k, v]) => [k, { ...v }])),
      },
      quests: this.questStates.map((q) => ({
        questId: q.questId as string,
        status: q.status,
        progress: q.progress.map((p) => ({ objectiveId: p.objectiveId, currentCount: p.currentCount })),
        startedAt: q.startedAt,
        completedAt: q.completedAt,
        rewardClaimed: q.rewardClaimed,
      })),
    };
  }
}

/* ==================== Serializacao ==================== */

function characterToSnapshot(s: CharacterState): CharacterSnapshotV1 {
  return {
    id: s.id, name: s.name, classId: s.classId, createdAt: s.createdAt,
    level: s.level, experience: s.experience, silver: s.silver,
    progressionPoints: s.progressionPoints, hp: s.hp, resource: s.resource,
    unlocks: Array.from(s.unlocks),
  };
}

function characterFromSnapshot(s: CharacterSnapshotV1): CharacterState {
  return {
    id: s.id, name: s.name, classId: asClassId(s.classId), createdAt: s.createdAt,
    level: s.level, experience: s.experience, silver: s.silver,
    progressionPoints: s.progressionPoints, hp: s.hp, resource: s.resource,
    unlocks: new Set(s.unlocks),
  };
}

function inventoryToSnapshot(inv: Inventory): InventorySnapshot {
  return {
    capacity: inv.capacity,
    slots: inv.list().map((s) => s ? { itemId: s.itemId as string, quantity: s.quantity, enhancementLevel: s.enhancementLevel, durability: s.durability, randomAttributes: s.randomAttributes ? s.randomAttributes.map((r) => ({ kind: r.kind, value: r.value })) : null, essences: s.essences ? s.essences.map((e) => e ? { itemId: e.itemId as string, level: e.level } : null) : null, essenceLevel: s.essenceLevel } : null),
  };
}

function inventoryFromSnapshot(snap: InventorySnapshot): Inventory {
  const initial = snap.slots.map((s) => s ? makeStack(asItemId(s.itemId), s.quantity, s.enhancementLevel, s.durability, s.randomAttributes ? s.randomAttributes.map((r) => ({ kind: r.kind as import('../domain/random-attributes/types').RandomAttributeKind, value: r.value })) : null, s.essences ? s.essences.map((e) => e ? { itemId: asItemId(e.itemId), level: e.level } : null) : null, s.essenceLevel) : null);
  return new Inventory(snap.capacity, initial);
}

function equipmentToSnapshot(state: ReadonlyMap<string, ItemStack>): EquipmentSnapshot {
  const obj: Record<string, ItemStackSnapshot> = {};
  for (const [k, v] of state) obj[k] = { itemId: v.itemId as string, quantity: v.quantity, enhancementLevel: v.enhancementLevel, durability: v.durability, randomAttributes: v.randomAttributes ? v.randomAttributes.map((r) => ({ kind: r.kind, value: r.value })) : null, essences: v.essences ? v.essences.map((e) => e ? { itemId: e.itemId as string, level: e.level } : null) : null, essenceLevel: v.essenceLevel };
  return { slots: obj };
}

function equipmentFromSnapshot(snap: EquipmentSnapshot): Equipment {
  const map = new Map<EquipmentSlotId, ItemStack>();
  for (const [k, v] of Object.entries(snap.slots)) map.set(k as EquipmentSlotId, makeStack(asItemId(v.itemId), v.quantity, v.enhancementLevel, v.durability, v.randomAttributes ? v.randomAttributes.map((r) => ({ kind: r.kind as import('../domain/random-attributes/types').RandomAttributeKind, value: r.value })) : null, v.essences ? v.essences.map((e) => e ? { itemId: asItemId(e.itemId), level: e.level } : null) : null, v.essenceLevel));
  return new Equipment(map);
}

function configToSnapshot(c: CombatConfig): CombatConfigSnapshot {
  return { autoMode: c.autoMode, useSkills: c.useSkills, strategy: c.strategy, skillPriority: c.skillPriority.map((s) => s as string) };
}

function configFromSnapshot(s: CombatConfigSnapshot): CombatConfig {
  return {
    autoMode: s.autoMode, useSkills: s.useSkills,
    strategy: (s.strategy as CombatConfig['strategy']) ?? 'aggressive',
    skillPriority: s.skillPriority.map((x) => asSkillId(x)),
  };
}

function combatStateToSnapshot(state: CombatState, zoneId: ZoneId, monsterId: MonsterId): CombatSnapshot {
  const ready: Record<string, number> = {};
  for (const [k, v] of state.playerSkillReadyAt) ready[k as string] = v;
  return {
    zoneId: zoneId as string, monsterId: monsterId as string,
    timeMs: state.timeMs, playerHp: state.playerHp, playerResource: state.playerResource,
    playerNextAttackAt: state.playerNextAttackAt, playerSkillReadyAt: ready,
    monsterHp: state.monsterHp, monsterNextAttackAt: state.monsterNextAttackAt,
  };
}

function historyToSnapshot(h: readonly EnhancementHistoryEntry[]): readonly EnhancementHistorySnapshot[] {
  return h.map((e) => ({
    itemId: e.itemId as string, previousLevel: e.previousLevel, attemptedLevel: e.attemptedLevel,
    success: e.success, destroyed: e.destroyed, usedProtection: e.usedProtection, timestamp: e.timestamp,
  }));
}

function historyFromSnapshot(h: readonly EnhancementHistorySnapshot[]): readonly EnhancementHistoryEntry[] {
  return h.map((e) => ({
    itemId: asItemId(e.itemId), previousLevel: e.previousLevel, attemptedLevel: e.attemptedLevel,
    success: e.success, destroyed: e.destroyed, usedProtection: e.usedProtection, timestamp: e.timestamp,
  }));
}

function professionsToSnapshot(m: ReadonlyMap<ProfessionId, ProfessionState>): Record<string, ProfessionStateSnapshot> {
  const out: Record<string, ProfessionStateSnapshot> = {};
  for (const [k, v] of m) out[k as string] = { level: v.level, experience: v.experience, mastery: v.mastery };
  return out;
}

function professionsFromSnapshot(snap: Readonly<Record<string, ProfessionStateSnapshot>>): Map<ProfessionId, ProfessionState> {
  const map = new Map<ProfessionId, ProfessionState>();
  for (const [k, v] of Object.entries(snap)) map.set(asProfessionId(k), { level: v.level, experience: v.experience, mastery: v.mastery });
  return map;
}

function activityToSnapshot(a: ActivityState): ActivitySnapshot {
  return { kind: a.kind, targetId: a.targetId, startedAt: a.startedAt, cycleMs: a.cycleMs, batches: a.batches, completedActions: a.completedActions };
}

function activityFromSnapshot(snap: ActivitySnapshot | null): ActivityState | null {
  if (!snap) return null;
  return {
    kind: snap.kind, targetId: snap.targetId, startedAt: snap.startedAt, cycleMs: snap.cycleMs,
    batches: snap.batches, completedActions: snap.completedActions,
    expectedActions: snap.batches,
    endsAt: snap.startedAt + snap.cycleMs * snap.batches,
  };
}

function farmToSnapshot(farm: FarmState): readonly FarmPlotSnapshot[] {
  return farm.plots.map((p) => ({
    id: p.id, cropNodeId: p.cropNodeId as string | null,
    plantedAt: p.plantedAt, readyAt: p.readyAt,
  }));
}

function farmFromSnapshot(snap: readonly FarmPlotSnapshot[]): FarmState {
  if (snap.length === 0) return newFarmState(DEFAULT_PLOT_COUNT);
  const plots: FarmPlot[] = snap.map((p) => ({
    id: p.id,
    cropNodeId: p.cropNodeId ? asNodeId(p.cropNodeId) : null,
    plantedAt: p.plantedAt,
    readyAt: p.readyAt,
  }));
  return { plotCount: plots.length, plots };
}


/* ==================== Serializacao Idle ==================== */

function idleSetupToSnapshot(setup: IdleSetup): import('../persistence/save-schema').IdleConfigSnapshot {
  return {
    kind: setup.activity.kind,
    targetId: setup.activity.kind === 'combat' ? (setup.activity.zoneId as string)
      : setup.activity.kind === 'gathering' ? (setup.activity.nodeId as string)
      : (setup.activity.recipeId as string),
    batchesPerCycle: setup.activity.kind === 'production' ? setup.activity.batchesPerCycle : 1,
    autoHpItemId: setup.autoHpItemId ? (setup.autoHpItemId as string) : null,
    autoHpThreshold: setup.autoHpThreshold,
  };
}

function idleSetupFromSnapshot(snap: import('../persistence/save-schema').IdleConfigSnapshot | null): IdleSetup | null {
  if (!snap) return null;
  let activity: IdleConfig;
  if (snap.kind === 'combat') {
    activity = { kind: 'combat', zoneId: asZoneId(snap.targetId) };
  } else if (snap.kind === 'gathering') {
    activity = { kind: 'gathering', nodeId: asNodeId(snap.targetId) };
  } else {
    activity = { kind: 'production', recipeId: asRecipeId(snap.targetId), batchesPerCycle: Math.max(1, snap.batchesPerCycle) };
  }
  return {
    activity,
    autoHpItemId: snap.autoHpItemId ? asItemId(snap.autoHpItemId) : null,
    autoHpThreshold: snap.autoHpThreshold,
  };
}

function idleReportToSnapshot(report: IdleReport): import('../persistence/save-schema').IdleReportSnapshot {
  return {
    startedAt: report.startedAt, endedAt: report.endedAt,
    simulatedMs: report.simulatedMs, cappedMs: report.cappedMs, wasCapped: report.wasCapped,
    config: idleSetupToSnapshot({ activity: report.config, autoHpItemId: null, autoHpThreshold: 0 }),
    outcome: report.outcome,
    xpGained: report.xpGained, silverGained: report.silverGained,
    loot: report.loot.map((l) => ({ itemId: l.itemId as string, quantity: l.quantity })),
    kills: report.kills, actions: report.actions, batches: report.batches,
    consumablesUsed: report.consumablesUsed, notes: report.notes,
  };
}

function idleReportFromSnapshot(snap: import('../persistence/save-schema').IdleReportSnapshot | null): IdleReport | null {
  if (!snap) return null;
  const setup = idleSetupFromSnapshot(snap.config);
  if (!setup) return null;
  return {
    startedAt: snap.startedAt, endedAt: snap.endedAt,
    simulatedMs: snap.simulatedMs, cappedMs: snap.cappedMs, wasCapped: snap.wasCapped,
    config: setup.activity, outcome: snap.outcome as IdleReport['outcome'],
    xpGained: snap.xpGained, silverGained: snap.silverGained,
    loot: snap.loot.map((l) => ({ itemId: asItemId(l.itemId), quantity: l.quantity })),
    kills: snap.kills, actions: snap.actions, batches: snap.batches,
    consumablesUsed: snap.consumablesUsed, notes: snap.notes,
  };
