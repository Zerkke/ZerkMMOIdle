    switch (err) {
      case 'max-level': return 'Essencia no nivel maximo.';
      case 'not-enough-silver': return 'Prata insuficiente.';
      case 'not-enough-materials': return 'Faltam materiais.';
      case 'no-config': return 'Configuracao em falta.';
      default: return 'Upgrade invalido.';
    }
  }

  private describeSacrificeError(err: string | null): string {
    switch (err) {
      case 'wrong-count': return 'Precisas de 3 essencias iguais.';
      case 'mismatch-item': return 'As essencias tem de ser do mesmo tipo.';
      case 'mismatch-level': return 'As essencias tem de ser do mesmo nivel.';
      case 'max-level': return 'Nivel maximo atingido.';
      default: return 'Sacrificio invalido.';
    }
  }
  private describeEssenceError(err: string | null): string {
    switch (err) {
      case 'slot-occupied': return 'Slot de essencia ja ocupado.';
      case 'slot-out-of-range': return 'Slot de essencia invalido.';
      case 'incompatible-slot': return 'Essencia incompativel com este equipamento.';
      case 'not-enough-silver': return 'Prata insuficiente.';
      case 'stack-limit-reached': return 'Limite de stack atingido.';
      case 'item-not-equippable': return 'Este item nao aceita essencias.';
      case 'essence-not-equipped': return 'Sem essencia para remover.';
