  private triggerTutorial(event: TriggerEvent): void {
    const before = this.tutorial;
    const { state, newlyCompleted } = applyTutorialEvent(before, TUTORIAL_STEPS, event, Date.now());
    if (state === before) return;
    this.tutorial = state;

    for (const step of newlyCompleted) {
      // Recompensas
      this.character = addSilver(this.character, step.rewardSilver);
      if (step.rewardXp > 0) {
        this.character = applyExperience(this.character, step.rewardXp).state;
      }
      this.tutorial = markRewardClaimed(this.tutorial, step.id);
      this.emit({
        type: 'notice',
        message: 'Objetivo concluido: ' + step.title + ' (+' + step.rewardSilver + ' prata)',
        level: 'info',
      });
    }

    this.emit({ type: 'tutorial-changed' });
    this.emit({ type: 'character-changed' });
  }
  /* ==================== Quests ==================== */

  getAllQuests(): { state: QuestState; def: (typeof QUESTS)[number] }[] {
    const out: { state: QuestState; def: (typeof QUESTS)[number] }[] = [];
    for (const s of this.questStates) {
      const def = QUESTS.find((d) => d.id === s.questId);
      if (def) out.push({ state: s, def });
    }
    return out;
  }

  getQuestsByStatus(status: QuestState['status']) {
    return listByStatus(this.questStates, QUESTS, status);
  }

  getQuestState(questId: string): QuestState | null {
    return this.questStates.find((s) => s.questId === questId) ?? null;
  }

  acceptQuestById(questId: string): boolean {
    const before = this.questStates;
    this.questStates = acceptQuest(before, questId, Date.now());
    if (this.questStates === before) return false;
    this.emit({ type: 'quest-changed' });
    this.emit({ type: 'notice', message: 'Missao aceite.', level: 'info' });
    return true;
  }

  claimQuestReward(questId: string): boolean {
    const state = this.questStates.find((s) => s.questId === questId);
    if (!state || state.status !== 'completed' || state.rewardClaimed) return false;
    const def = QUESTS.find((d) => d.id === questId);
    if (!def) return false;

    // Aplicar recompensas
    this.character = addSilver(this.character, def.rewardSilver);
    if (def.rewardXp > 0) {
      const prevLevel = this.character.level;
      this.character = applyExperience(this.character, def.rewardXp).state;
      if (this.character.level > prevLevel) {
        const d = this.getDerivedStats();
        this.character = { ...this.character, hp: d.maxHp, resource: d.maxResource };
      }
    }
    const itemDeltas: { itemId: ItemId; delta: number }[] = [];
    for (const r of def.rewardItems) {
      const itemDef = this.registry.getItem(r.itemId);
      if (!itemDef) continue;
      const dur = isTool(itemDef) ? itemDef.maxDurability : null;
      this.inventory.add(r.itemId, r.quantity, itemDef.maxStack, 0, dur);
      itemDeltas.push({ itemId: r.itemId, delta: r.quantity });
    }
    this.ledger.record('quest', def.rewardSilver, itemDeltas, 'Missao: ' + def.name, Date.now());

    this.questStates = claimReward(this.questStates, questId);
    // Reavaliar disponibilidade (o proximo pode ter ficado disponivel)
    this.questStates = evaluateAvailability(this.questStates, QUESTS, this.character.level);

    this.emit({ type: 'quest-changed' });
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'notice', message: 'Recompensa recebida: ' + def.name, level: 'info' });
    return true;
  }

  private triggerQuest(event: QuestEvent): void {
    const before = this.questStates;
    const result = applyQuestEvent(before, QUESTS, event);
    if (result.states === before) return;
    this.questStates = result.states;

    for (const questId of result.newlyCompleted) {
      const def = QUESTS.find((d) => d.id === questId);
      if (!def) continue;
      this.emit({
        type: 'notice',
        message: 'Missao concluida: ' + def.name + ' (reclama recompensa)',
        level: 'info',
      });
    }

    // Reavaliar disponibilidade (o nivel pode ter subido)
    this.questStates = evaluateAvailability(this.questStates, QUESTS, this.character.level);
    this.emit({ type: 'quest-changed' });
  }
  /* ==================== Essencias (Fase 17) ==================== */

  getEssenceBonuses() {
    const items: ItemStack[] = [];
    for (const stack of this.equipment.list().values()) items.push(stack);
    const map = new Map<ItemId, EssenceDefinition>();
    for (const e of ESSENCES) map.set(e.itemId, e);
    const evolutionConfigs = new Map<string, import('../domain/essence/types').EssenceEvolutionConfig>();
    for (const [k, v] of Object.entries(ESSENCE_EVOLUTION)) evolutionConfigs.set(k, v);
    return sumEssenceBonuses(items, map, evolutionConfigs);
  }

  getEssenceDefinitions(): readonly EssenceDefinition[] {
    return ESSENCES;
  }

  getEssenceDefinitionForItem(itemId: ItemId): EssenceDefinition | undefined {
    return getEssenceByItemId(itemId as string);
  }

  getEssenceApplyCost(_essenceDef: EssenceDefinition): number {
    return BALANCE.essence.applyCostPerTier;
  }

  getEssenceRemoveCost(essenceDef: EssenceDefinition): number {
    return BALANCE.essence.removeCostPerTier * essenceDef.tier;
  }

  applyEssenceToEquipped(equipmentSlot: EquipmentSlotId, essenceSlotIndex: number, instance: EssenceInstance): boolean {
    const stack = this.equipment.get(equipmentSlot);
    if (!stack) { this.emit({ type: 'notice', message: 'Slot vazio.', level: 'warn' }); return false; }
    const itemDef = this.registry.getItem(stack.itemId);
    if (!itemDef) return false;
    const essenceDef = getEssenceByItemId(instance.itemId as string);
    if (!essenceDef) { this.emit({ type: 'notice', message: 'Item nao e uma essencia.', level: 'warn' }); return false; }

    const cost = this.getEssenceApplyCost(essenceDef);
    const invIndex = this.findInventorySlotMatching(instance.itemId, instance.level);
    if (invIndex < 0) { this.emit({ type: 'notice', message: 'Essencia nao esta no inventario.', level: 'warn' }); return false; }

    const result = applyEssence({
      item: stack,
      itemDef,
      instance,
      essenceDef,
      slotIndex: essenceSlotIndex,
      playerSilver: this.character.silver,
      cost,
    });
    if (!result.ok || !result.newItem) {
      this.emit({ type: 'notice', message: this.describeEssenceError(result.error), level: 'warn' });
      return false;
    }

    const removed = this.inventory.removeAt(invIndex);
    if (!removed) return false;
    this.equipment.setSlot(equipmentSlot, result.newItem);
    if (result.silverDelta) this.character = addSilver(this.character, result.silverDelta);
    this.emit({ type: 'equipment-changed' });
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'notice', message: essenceDef.name + ' L' + instance.level + ' aplicada.', level: 'info' });
    return true;
  }
  removeEssenceFromEquipped(equipmentSlot: EquipmentSlotId, essenceSlotIndex: number): boolean {
    const stack = this.equipment.get(equipmentSlot);
    if (!stack) return false;
    const itemDef = this.registry.getItem(stack.itemId);
    if (!itemDef) return false;
    if (!stack.essences || !stack.essences[essenceSlotIndex]) {
      this.emit({ type: 'notice', message: 'Sem essencia nesse slot.', level: 'warn' });
      return false;
    }
    const current = stack.essences[essenceSlotIndex]!;
    const essenceDef = getEssenceByItemId(current.itemId as string);
    if (!essenceDef) return false;
    const cost = this.getEssenceRemoveCost(essenceDef);

    const test = this.inventory.add(current.itemId, 1, 1, 0, null, null, null, current.level);
    if (test.added !== 1) {
      this.inventory.remove(current.itemId, test.added);
      this.emit({ type: 'notice', message: 'Inventario cheio.', level: 'warn' });
      return false;
    }
    this.inventory.remove(current.itemId, 1);

    const result = removeEssence({
      item: stack, itemDef, slotIndex: essenceSlotIndex,
      playerSilver: this.character.silver, cost,
    });
    if (!result.ok || !result.newItem || !result.removedInstance) {
      this.emit({ type: 'notice', message: this.describeEssenceError(result.error), level: 'warn' });
      return false;
    }

    const addResult = this.inventory.add(
      result.removedInstance.itemId, 1, 1, 0, null, null, null, result.removedInstance.level,
    );
    if (addResult.added !== 1) {
      this.emit({ type: 'notice', message: 'Inventario cheio.', level: 'warn' });
      return false;
    }
    this.equipment.setSlot(equipmentSlot, result.newItem);
    if (result.silverDelta) this.character = addSilver(this.character, result.silverDelta);
    this.emit({ type: 'equipment-changed' });
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'notice', message: essenceDef.name + ' L' + current.level + ' removida.', level: 'info' });
    return true;
  }getEssenceBonusAtLevel(itemId: ItemId, level: number) {
    const def = getEssenceByItemId(itemId as string);
    if (!def) return null;
    const cfg = ESSENCE_EVOLUTION[def.kind + '.t' + def.tier];
    if (!cfg) return null;
    return bonusAtLevel(def, cfg, level);
  }

  checkEssenceUpgrade(slotIndex: number) {
    const slots = this.inventory.list();
    const s = slots[slotIndex];
    if (!s) return null;
    const def = getEssenceByItemId(s.itemId as string);
    if (!def) return null;
    const cfg = ESSENCE_EVOLUTION[def.kind + '.t' + def.tier];
    if (!cfg) return null;
    const instance: EssenceInstance = { itemId: s.itemId, level: s.essenceLevel ?? 1 };
    const counts = new Map<string, number>();
    for (const st of slots) {
      if (st) counts.set(st.itemId as string, (counts.get(st.itemId as string) ?? 0) + st.quantity);
    }
    return checkUpgrade(instance, cfg, this.character.silver, counts);
  }

  checkEssenceSacrifice(slotIndex: number) {
    const slots = this.inventory.list();
    const s = slots[slotIndex];
    if (!s) return null;
    const def = getEssenceByItemId(s.itemId as string);
    if (!def) return null;
    const cfg = ESSENCE_EVOLUTION[def.kind + '.t' + def.tier];
    if (!cfg) return null;
    const lvl = s.essenceLevel ?? 1;
    const matching: EssenceInstance[] = [];
    for (const st of slots) {
      if (!st) continue;
      if (st.itemId === s.itemId && (st.essenceLevel ?? 1) === lvl) {
        for (let k = 0; k < st.quantity; k++) matching.push({ itemId: st.itemId, level: lvl });
      }
    }
    return checkSacrifice(matching, cfg.maxLevel);
  }

  upgradeEssenceInInventory(slotIndex: number): boolean {
    const slots = this.inventory.list();
    const s = slots[slotIndex];
    if (!s) return false;
    const def = getEssenceByItemId(s.itemId as string);
    if (!def) { this.emit({ type: 'notice', message: 'Item nao e uma essencia.', level: 'warn' }); return false; }
    const cfg = ESSENCE_EVOLUTION[def.kind + '.t' + def.tier];
    if (!cfg) return false;

    const instance: EssenceInstance = { itemId: s.itemId, level: s.essenceLevel ?? 1 };
    const counts = new Map<string, number>();
    for (const st of slots) {
      if (st) counts.set(st.itemId as string, (counts.get(st.itemId as string) ?? 0) + st.quantity);
    }
    const check = checkUpgrade(instance, cfg, this.character.silver, counts);
    if (!check.ok || !check.cost) {
      this.emit({ type: 'notice', message: this.describeUpgradeError(check.error), level: 'warn' });
      return false;
    }

    this.character = addSilver(this.character, -check.cost.silver);
    for (const m of check.cost.materials) {
      const removed = this.inventory.remove(m.itemId, m.quantity);
      if (removed.removed !== m.quantity) {
        this.emit({ type: 'notice', message: 'Erro ao consumir materiais.', level: 'error' });
        return false;
      }
    }
    const newLevel = check.toLevel;
    this.inventory.setAt(slotIndex, { ...s, essenceLevel: newLevel });
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'notice', message: def.name + ' melhorada para L' + newLevel + '.', level: 'info' });
    return true;
  }

  sacrificeEssencesAt(slotIndex: number): boolean {
    const slots = this.inventory.list();
    const s = slots[slotIndex];
    if (!s) return false;
    const def = getEssenceByItemId(s.itemId as string);
    if (!def) return false;
    const cfg = ESSENCE_EVOLUTION[def.kind + '.t' + def.tier];
    if (!cfg) return false;

    const lvl = s.essenceLevel ?? 1;
    const matchingIndices: number[] = [];
    for (let i = 0; i < slots.length; i++) {
      const st = slots[i];
      if (!st) continue;
      if (st.itemId === s.itemId && (st.essenceLevel ?? 1) === lvl) matchingIndices.push(i);
      if (matchingIndices.length >= SACRIFICE_REQUIRED) break;
    }
    if (matchingIndices.length < SACRIFICE_REQUIRED) {
      this.emit({ type: 'notice', message: 'Precisas de 3 essencias iguais do mesmo nivel.', level: 'warn' });
      return false;
    }

    const matching: EssenceInstance[] = matchingIndices.map(() => ({ itemId: s.itemId, level: lvl }));
    const check = checkSacrifice(matching, cfg.maxLevel);
    if (!check.ok) {
      this.emit({ type: 'notice', message: this.describeSacrificeError(check.error), level: 'warn' });
      return false;
    }
    const cost = sacrificeCost(lvl);
    if (this.character.silver < cost) {
      this.emit({ type: 'notice', message: 'Prata insuficiente (' + cost + ').', level: 'warn' });
      return false;
    }

    this.character = addSilver(this.character, -cost);
    for (const idx of matchingIndices) this.inventory.setAt(idx, null);
    const addResult = this.inventory.add(s.itemId, 1, 1, 0, null, null, null, check.resultLevel);
    if (addResult.added !== 1) {
      this.emit({ type: 'notice', message: 'Inventario cheio.', level: 'error' });
      return false;
    }
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'notice', message: '3x L' + lvl + ' -> 1x L' + check.resultLevel, level: 'info' });
    return true;
  }

  private findInventorySlotMatching(itemId: ItemId, essenceLevel: number): number {
    const slots = this.inventory.list();
    for (let i = 0; i < slots.length; i++) {
      const s = slots[i];
      if (s && s.itemId === itemId && s.essenceLevel === essenceLevel) return i;
    }
    return -1;
  }
