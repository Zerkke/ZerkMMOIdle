  private getCompletedQuestIds(): ReadonlySet<string> {
    const set = new Set<string>();
    for (const q of this.questStates) {
      if (q.status === 'completed') set.add(q.questId as string);
    }
    return set;
  }

  /** Pode o jogador entrar nesta zona? */
  canEnterZone(zoneId: ZoneId): { ok: boolean; reason: string | null } {
    const zone = this.registry.getZone(zoneId);
    if (!zone) return { ok: false, reason: 'Zona inexistente.' };
    const access = this.getZoneAccess(zoneId);
    if (!access || access.access !== 'unlocked') {
      return { ok: false, reason: access?.reason ?? 'Zona bloqueada.' };
    }
    if (zone.minLevel > this.character.level) {
      return { ok: false, reason: 'Requer nivel ' + zone.minLevel + '.' };
    }
    return { ok: true, reason: null };
  }

