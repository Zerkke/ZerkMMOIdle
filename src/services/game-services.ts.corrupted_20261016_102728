  getZoneAccess(zoneId: ZoneId): ZoneAccessInfo | null {
    const zone = this.registry.getZone(zoneId);
    if (!zone) return null;
    return evaluateZoneAccess(zone, this.character.level, this.getCompletedQuestIds());
