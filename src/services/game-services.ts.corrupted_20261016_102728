  constructor(readonly registry: ContentRegistry, save: SaveLatest, rng: () => number = Math.random) {
    this.rng = rng;
    this.character = characterFromSnapshot(save.character);
    this.inventory = inventoryFromSnapshot(save.inventory);
    this.equipment = equipmentFromSnapshot(save.equipment);
    this.combatConfig = configFromSnapshot(save.combatConfig);
    this.enhancementHistory = historyFromSnapshot(save.enhancementHistory);
    this.professionStates = professionsFromSnapshot(save.professionStates);
    this.activity = activityFromSnapshot(save.activity);
    this.buffs = BuffManager.fromSnapshot(
      save.buffs.map((b) => ({ buffId: asBuffId(b.buffId), kind: b.kind as BuffKind, magnitude: b.magnitude, appliedAt: b.appliedAt, expiresAt: b.expiresAt })),
      Date.now(),
    );
    this.farm = farmFromSnapshot(save.farm);
    this.warehouse = inventoryFromSnapshot(save.warehouse);
    this.ledger = TransactionLedger.fromSnapshot(save.transactions.map((t) => ({
      id: t.id,
      category: t.category as TransactionCategory,
      silverDelta: t.silverDelta,
      itemDeltas: t.itemDeltas.map((d) => ({ itemId: asItemId(d.itemId), delta: d.delta })),
      label: t.label,
      timestamp: t.timestamp,
    })));
    this.idleSetup = idleSetupFromSnapshot(save.idleSetup);
    this.lastIdleReport = idleReportFromSnapshot(save.lastIdleReport);
    this.tutorial = save.tutorial
      ? { entries: save.tutorial.entries.map((e) => ({ stepId: e.stepId, completed: e.completed, currentCount: e.currentCount, completedAt: e.completedAt })), rewardClaimed: save.tutorial.rewardClaimed }
      : newTutorialState(TUTORIAL_STEPS);
    this.questStates = save.quests.length > 0
      ? save.quests.map((q) => ({
          questId: asQuestId(q.questId),
          status: q.status as QuestState['status'],
          progress: q.progress.map((p) => ({ objectiveId: p.objectiveId, currentCount: p.currentCount })),
          startedAt: q.startedAt,
          completedAt: q.completedAt,
          rewardClaimed: q.rewardClaimed,
        }))
      : newQuestStates(QUESTS);
    // Avaliar disponibilidade logo no arranque (com base no nivel atual)
    this.questStates = evaluateAvailability(this.questStates, QUESTS, this.character.level);
    const talentsInitial: TalentState = save.talents
      ? { ranks: { ...save.talents.ranks }, respecCount: save.talents.respecCount }
      : { ranks: {}, respecCount: 0 };
    this.talentsService = new TalentsService(
      TALENT_TREE,
      {
        getCharacterLevel: () => this.character.level,
        getProgressionPoints: () => this.character.progressionPoints,
        getSilver: () => this.character.silver,
        spendSilver: (amount: number) => {
          if (this.character.silver < amount) return false;
          this.character = { ...this.character, silver: this.character.silver - amount };
          return true;
        },
      },
      talentsInitial,
    );
    const specInitial: SpecializationState = save.specialization
      ? {
          active: (save.specialization.active as SpecializationState['active']) ?? null,
          changeCount: save.specialization.changeCount,
          lastChangeAt: save.specialization.lastChangeAt,
        }
      : { active: null, changeCount: 0, lastChangeAt: 0 };
    this.specializationsService = new SpecializationsService(
      SPECIALIZATION_TREE,
      {
        getCharacterLevel: () => this.character.level,
        getTalentRank: (talentId: string) => this.talentsService.getRank(talentId),
        getSilver: () => this.character.silver,
        spendSilver: (amount: number) => {
          if (this.character.silver < amount) return false;
          this.character = { ...this.character, silver: this.character.silver - amount };
          return true;
        },
      },
      specInitial,
    );
    const dungeonsInitial: DungeonsState = save.dungeons
      ? {
          active: save.dungeons.active ? { ...save.dungeons.active } : null,
          results: Object.fromEntries(Object.entries(save.dungeons.results).map(([k, v]) => [k, { ...v }])),
        }
      : { active: null, results: {} };
    this.dungeonsService = new DungeonsService(
      DUNGEONS,
      {
        getCharacterLevel: () => this.character.level,
        getAp: () => this.getDerivedStats().ap,
        getDp: () => this.getDerivedStats().dp,
        getSilver: () => this.character.silver,
        spendSilver: (amount: number) => {
          if (this.character.silver < amount) return false;
          this.character = { ...this.character, silver: this.character.silver - amount };
          return true;
        },
      },
      dungeonsInitial,
    );
    this.ensureAllProfessions();
    this.repairLegacyTools();
    this.ensureStartingTools();
    this.ensureStartingSeeds();
  }

  static createInitial(registry: ContentRegistry, rng: () => number = Math.random): GameServices {
    const now = Date.now();
    const classDef = registry.getClass(asClassId('class.ferrumancer'));
    const baseAttrs = classDef?.attributes ?? ZERO_ATTRIBUTES;
    const derived = deriveStats(baseAttrs, ZERO_POWER);

    const character: CharacterState = {
      id: 'local', name: 'Aventureiro', classId: asClassId('class.ferrumancer'),
      createdAt: now, level: 1, experience: 0, silver: 500,
      progressionPoints: 0, hp: derived.maxHp, resource: derived.maxResource,
      unlocks: new Set(),
    };

    const inventory = new Inventory(40);
    for (const entry of DEMO_STARTING_INVENTORY) {
      const itemId = asItemId(entry.itemId);
      const def = registry.getItem(itemId);
      if (!def) continue;
      const durability = isTool(def) ? def.maxDurability : null;
      inventory.add(itemId, entry.quantity, def.maxStack, 0, durability);
    }

    return new GameServices(registry, {
      schemaVersion: 15,
      savedAt: now,
      character: characterToSnapshot(character),
      inventory: inventoryToSnapshot(inventory),
      warehouse: { capacity: 100, slots: [] },
      equipment: equipmentToSnapshot(emptyEquipment()),
      combat: null,
      combatConfig: { autoMode: true, useSkills: true, strategy: 'aggressive', skillPriority: [] },
      enhancementHistory: [],
      professionStates: {},
      activity: null,
      buffs: [],
      farm: farmToSnapshot(newFarmState(DEFAULT_PLOT_COUNT)),
      transactions: [],
      idleSetup: null,
      lastIdleReport: null,
      tutorial: null,
      quests: [],
      talents: { ranks: {}, respecCount: 0 },
      specialization: { active: null, changeCount: 0, lastChangeAt: 0 },
      dungeons: { active: null, results: {} },
    }, rng);
  }

  subscribe(listener: Listener): () => void {
    this.listeners.add(listener);
    return () => { this.listeners.delete(listener); };
  }

  private emit(event: ServiceEvent): void { for (const l of this.listeners) l(event); }

  getCharacter(): CharacterState { return this.character; }
  getInventory(): Inventory { return this.inventory; }
  getEquipment(): Equipment { return this.equipment; }
  getCombatConfig(): CombatConfig { return this.combatConfig; }
  getEnhancementHistory(): readonly EnhancementHistoryEntry[] { return this.enhancementHistory; }
  getTalentsService(): TalentsService { return this.talentsService; }
  spendTalentPoint(talentId: string): boolean {
    const ok = this.talentsService.spend(talentId);
    if (ok) this.emit({ type: 'talents-changed' });
    return ok;
  }
  respecTalents(): { ok: boolean; cost: number } {
    const r = this.talentsService.respec();
    if (r.ok) {
      this.emit({ type: 'talents-changed' });
      this.emit({ type: 'character-changed' });
    }
    return r;
  }
  getSpecializationsService(): SpecializationsService { return this.specializationsService; }
  getDungeonsService(): DungeonsService { return this.dungeonsService; }
  startDungeon(dungeonId: string): boolean {
    if (this.combatState) { this.emit({ type: 'notice', message: 'Termina o combate atual primeiro.', level: 'warn' }); return false; }
    if (this.activity) { this.emit({ type: 'notice', message: 'Termina a atividade atual primeiro.', level: 'warn' }); return false; }
    const r = this.dungeonsService.start(dungeonId, Date.now());
    if (!r.ok) {
      const reasonMap: Record<string, string> = {
        'unknown-dungeon': 'Dungeon desconhecida.',
        'already-active': 'Ja tens uma dungeon ativa.',
        'level-too-low': 'Nivel insuficiente.',
        'not-enough-silver': 'Prata insuficiente.',
      };
      this.emit({ type: 'notice', message: reasonMap[r.reason ?? ''] ?? 'Nao foi possivel iniciar.', level: 'warn' });
      return false;
    }
    this.currentZoneId = null;
    this.currentZoneScaling = null;
    this.sessionKills = 0; this.sessionXp = 0; this.sessionSilver = 0;
    this.sessionLoot = new Map(); this.combatLog = []; this.pausedUntilMs = 0;
    this.spawnNextMonster(Date.now());
    this.emit({ type: 'dungeon-changed' });
    this.emit({ type: 'combat-changed' });
    return true;
  }
  abandonDungeon(): void {
    if (!this.dungeonsService.isActive()) return;
    this.dungeonsService.abandon();
    this.stopCombat();
    this.emit({ type: 'dungeon-changed' });
    this.emit({ type: 'notice', message: 'Dungeon abandonada.', level: 'warn' });
  }
  activateSpecialization(specId: import('../domain/specializations/types').SpecializationId): boolean {
    const r = this.specializationsService.activate(specId, Date.now());
    if (!r.ok) return false;
    this.clampPlayerStats();
    this.emit({ type: 'specialization-changed' });
    this.emit({ type: 'character-changed' });
    return true;
  }
  deactivateSpecialization(): void {
    this.specializationsService.deactivate(Date.now());
    this.clampPlayerStats();
    this.emit({ type: 'specialization-changed' });
    this.emit({ type: 'character-changed' });
  }
  getExperienceToNext(): number { return experienceToNextLevel(this.character.level); }

  getProfessionState(id: ProfessionId): ProfessionState {
    return this.professionStates.get(id) ?? newProfessionState();
  }

  /* ==================== BUFFS ==================== */

  getActiveBuffs(): readonly ActiveBuff[] { return this.buffs.list(); }

  applyBuffById(buffId: BuffId, nowMs: number): ApplyResult | null {
    const def = this.registry.getBuff(buffId);
    if (!def) return null;
    const result = this.buffs.apply(def, nowMs);
    this.emit({ type: 'buff-changed' });
    return result;
  }

  consumeItem(slotIndex: number): boolean {
    const slot = this.inventory.list()[slotIndex];
    if (!slot) return false;
    const def = this.registry.getItem(slot.itemId);
    if (!def) return false;
    if (def.appliesBuffId === null) {
      this.emit({ type: 'notice', message: def.name + ' nao tem efeito.', level: 'warn' });
      return false;
    }
    const consumed = this.inventory.remove(slot.itemId, 1);
    if (consumed.removed !== 1) return false;
    const buffDef = this.registry.getBuff(def.appliesBuffId);
    if (!buffDef) {
      this.inventory.add(slot.itemId, 1, def.maxStack, 0);
      return false;
    }
    const result = this.buffs.apply(buffDef, Date.now());
    if (!result.applied) {
      this.inventory.add(slot.itemId, 1, def.maxStack, 0);
      this.emit({ type: 'notice', message: result.reason ?? 'Nao foi possivel aplicar o buff.', level: 'warn' });
      return false;
    }
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'buff-changed' });
    this.emit({ type: 'notice', message: result.refreshed ? def.name + ' renovado.' : def.name + ' aplicado.', level: 'info' });
    return true;
  }

  private buffModifier(kind: BuffKind): number { return this.buffs.modifier(kind); }

  /* ==================== AGRICULTURA ==================== */

  getFarm(): readonly FarmPlotInfo[] {
    const now = Date.now();
    return this.farm.plots.map((p) => {
      const node = p.cropNodeId ? this.registry.getNode(p.cropNodeId) : null;
      return {
        id: p.id,
        cropNodeId: p.cropNodeId,
        cropName: node?.name ?? null,
        plantedAt: p.plantedAt,
        readyAt: p.readyAt,
        ready: isReady(p, now),
        progress: growthProgress(p, now),
      };
    });
  }

  plantSeed(seedSlotIndex: number, plotId: number): boolean {
    const slot = this.inventory.list()[seedSlotIndex];
    if (!slot) return false;
    const seedDef = this.registry.getItem(slot.itemId);
    if (!seedDef || !isSeed(seedDef)) {
      this.emit({ type: 'notice', message: 'Esse item nao e uma semente.', level: 'warn' });
      return false;
    }
    const cropNodeId = seedDef.seedForNodeId;
    if (!cropNodeId) return false;
    const cropNode = this.registry.getNode(cropNodeId);
    if (!cropNode) return false;
    const profState = this.getProfessionState(cropNode.professionId);
    if (profState.level < cropNode.requiredLevel) {
      this.emit({ type: 'notice', message: 'Requer nivel ' + cropNode.requiredLevel + ' em Agricultura.', level: 'warn' });
      return false;
    }
    const consumed = this.inventory.removeAt(seedSlotIndex);
    if (!consumed) return false;
    const now = Date.now();
    const readyAt = now + cropNode.baseTimeMs;
    const result = plantCrop(this.farm, plotId, cropNodeId, readyAt, now);
    if (result.error) {
      this.inventory.setAt(seedSlotIndex, consumed);
      this.emit({ type: 'notice', message: 'Erro: ' + result.error + '.', level: 'warn' });
      return false;
    }
    this.farm = result.state;
    this.triggerTutorial({ kind: 'plant-crop', targetId: null, amount: 1 });
    this.triggerQuest({ kind: 'plant-crop', targetId: null, amount: 1 });
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'farm-changed' });
    this.emit({ type: 'notice', message: 'Plantado em parcela ' + (plotId + 1) + '.', level: 'info' });
    return true;
  }

  harvestPlot(plotId: number): boolean {
    const now = Date.now();
    const result = harvestCrop(this.farm, plotId, now);
    if (result.error || !result.nodeId) {
      const msg = result.error === 'not-ready' ? 'Ainda nao esta pronto.'
        : result.error === 'plot-empty' ? 'Parcela vazia.'
        : 'Erro ao colher.';
      this.emit({ type: 'notice', message: msg, level: 'warn' });
      return false;
    }
    const node = this.registry.getNode(result.nodeId);
    if (!node) return false;
    const profState = this.getProfessionState(node.professionId);
    const yieldBonus = 1 + this.buffModifier('gather-yield');
    const drops = node.loot.map((e) => {
      const span = e.maxQuantity - e.minQuantity + 1;
      const qty = Math.floor((e.minQuantity + Math.floor(this.rng() * span)) * yieldBonus);
      return { itemId: e.itemId, quantity: Math.max(1, qty) };
    });
    for (const d of drops) {
      const def = this.registry.getItem(d.itemId);
      if (!def) continue;
      this.inventory.add(d.itemId, d.quantity, def.maxStack, 0);
    }
    const prof = this.registry.getProfession(node.professionId);
    if (prof) {
      const lr = addProfessionExperience(profState, node.baseExp, prof.maxLevel, prof.masteryPerLevel);
      this.professionStates.set(node.professionId, lr.state);
      if (lr.levelsGained > 0) this.emit({ type: 'notice', message: prof.name + ' subiu para nivel ' + lr.state.level + '!', level: 'info' });
    }
    this.farm = result.state;
    this.triggerTutorial({ kind: 'harvest-crop', targetId: null, amount: 1 });
    this.triggerQuest({ kind: 'harvest-crop', targetId: null, amount: 1 });
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'farm-changed' });
    this.emit({ type: 'notice', message: 'Colheita: ' + node.name + '.', level: 'info' });
    return true;
  }

  /* ==================== LIFESKILLS ==================== */

  getActivity(): LifeskillSessionInfo | null {
    if (!this.activity) return null;
    if (this.activity.kind === 'gathering') {
      const node = this.registry.getNode(this.activity.targetId as NodeId);
      if (!node) return null;
      return {
        kind: 'gathering', targetId: node.id, targetName: node.name,
        professionId: node.professionId, startedAt: this.activity.startedAt,
        cycleMs: this.activity.cycleMs, batches: this.activity.batches,
        completedActions: this.activity.completedActions,
        expectedEndAt: this.activity.startedAt + this.activity.cycleMs * this.activity.batches,
      };
    }
    const recipe = this.registry.getRecipe(this.activity.targetId as RecipeId);
    if (!recipe) return null;
    return {
      kind: 'production', targetId: recipe.id, targetName: recipe.name,
      professionId: recipe.professionId, startedAt: this.activity.startedAt,
      cycleMs: this.activity.cycleMs, batches: this.activity.batches,
      completedActions: this.activity.completedActions,
      expectedEndAt: this.activity.startedAt + this.activity.cycleMs * this.activity.batches,
    };
  }

  getEquippedTool(): ToolSnapshot | null {
    const stack = this.equipment.get('tool');
    if (!stack) return null;
    const def = this.registry.getItem(stack.itemId);
    if (!def || !def.toolCategory) return null;
    return {
      toolCategory: def.toolCategory,
      enhancementLevel: stack.enhancementLevel,
      durability: stack.durability ?? 0,
      maxDurability: def.maxDurability,
    };
  }

  canGatherAt(nodeId: NodeId): { ok: boolean; reason: string | null; tool: ToolSnapshot | null; requirement: ToolRequirement } {
    const node = this.registry.getNode(nodeId);
    if (!node) return { ok: false, reason: 'No desconhecido.', tool: null, requirement: evaluateToolRequirement(null, null) };
    if (node.kind === 'crop') return { ok: false, reason: 'Usa a Agricultura para culturas.', tool: null, requirement: evaluateToolRequirement(null, null) };
    const profState = this.getProfessionState(node.professionId);
    const tool = this.getEquippedTool();
    const requirement = evaluateToolRequirement(node.requiredTool, tool);
    if (profState.level < node.requiredLevel) {
      const profName = this.registry.getProfession(node.professionId)?.name ?? 'profissao';
      return { ok: false, reason: 'Requer nivel ' + node.requiredLevel + ' em ' + profName + '.', tool, requirement };
    }
    if (!requirement.matches) {
      const reqName = node.requiredTool ?? '-';
      return { ok: false, reason: requirement.present ? 'Requer ferramenta: ' + reqName + '.' : 'Equipa uma ferramenta: ' + reqName + '.', tool, requirement };
    }
    if (node.requiredTool && requirement.durability !== null && requirement.durability <= 0) {
      return { ok: false, reason: 'Ferramenta sem durabilidade.', tool, requirement };
    }
    return { ok: true, reason: null, tool, requirement };
  }

  startGathering(nodeId: NodeId, batches: number): boolean {
    if (this.activity) { this.emit({ type: 'notice', message: 'Ja existe uma atividade em curso.', level: 'warn' }); return false; }
    if (this.combatState) { this.emit({ type: 'notice', message: 'Termina o combate primeiro.', level: 'warn' }); return false; }
    if (!Number.isInteger(batches) || batches <= 0 || batches > 100) {
      this.emit({ type: 'notice', message: 'Numero de acoes invalido.', level: 'warn' }); return false;
    }
    const check = this.canGatherAt(nodeId);
    if (!check.ok) { this.emit({ type: 'notice', message: check.reason ?? 'Nao pode recolher.', level: 'warn' }); return false; }
    const node = this.registry.getNode(nodeId);
    if (!node) return false;
    const profState = this.getProfessionState(node.professionId);
    const speedBonus = this.buffModifier('gather-speed');
    const adjustedBase = Math.max(200, node.baseTimeMs * (1 - speedBonus));
    const cycleMs = effectiveActionTimeMs(adjustedBase, profState.mastery, check.tool);
    this.activity = {
      kind: 'gathering', targetId: nodeId, startedAt: Date.now(),
      cycleMs, batches, completedActions: 0, expectedActions: batches,
      endsAt: Date.now() + cycleMs * batches,
    };
    this.emit({ type: 'lifeskill-changed' });
    this.emit({ type: 'notice', message: 'A recolher em ' + node.name + '.', level: 'info' });
    return true;
  }

  validateRecipeForPlayer(recipeId: RecipeId, batches: number): ProductionCheck | null {
    const recipe = this.registry.getRecipe(recipeId);
    if (!recipe) return null;
    const profState = this.getProfessionState(recipe.professionId);
    if (profState.level < recipe.requiredLevel) {
      const profName = this.registry.getProfession(recipe.professionId)?.name ?? '';
      return { canStart: false, missingInputs: [], missingSilver: 0, reason: 'Requer nivel ' + recipe.requiredLevel + ' em ' + profName + '.' };
    }
    const bag = { count: (itemId: ItemId) => this.inventory.count(itemId), consume: () => false };
    const wallet = { silver: () => this.character.silver, spendSilver: () => false };
    return validateRecipe(recipe, batches, bag, wallet);
  }

  startProduction(recipeId: RecipeId, batches: number): boolean {
    if (this.activity) { this.emit({ type: 'notice', message: 'Ja existe uma atividade em curso.', level: 'warn' }); return false; }
    if (this.combatState) { this.emit({ type: 'notice', message: 'Termina o combate primeiro.', level: 'warn' }); return false; }
    const recipe = this.registry.getRecipe(recipeId);
    if (!recipe) { this.emit({ type: 'notice', message: 'Receita desconhecida.', level: 'error' }); return false; }
    const check = this.validateRecipeForPlayer(recipeId, batches);
    if (!check || !check.canStart) { this.emit({ type: 'notice', message: check?.reason ?? 'Receita invalida.', level: 'warn' }); return false; }
    const bag = {
      count: (itemId: ItemId) => this.inventory.count(itemId),
      consume: (itemId: ItemId, qty: number) => this.inventory.remove(itemId, qty).removed === qty,
    };
    const wallet = {
      silver: () => this.character.silver,
      spendSilver: (amount: number) => {
        if (this.character.silver < amount) return false;
        this.character = { ...this.character, silver: this.character.silver - amount };
        return true;
      },
    };
    if (!consumeInputs(recipe, batches, bag, wallet)) {
      this.emit({ type: 'notice', message: 'Erro ao consumir materiais.', level: 'error' }); return false;
    }
    const profState = this.getProfessionState(recipe.professionId);
    const speedBonus = this.buffModifier('craft-speed');
    const cycleMs = Math.max(200, Math.floor(recipe.baseTimeMs * (1 - Math.min(0.4, profState.mastery * 0.001)) * (1 - speedBonus)));
    this.activity = {
      kind: 'production', targetId: recipeId, startedAt: Date.now(),
      cycleMs, batches, completedActions: 0, expectedActions: batches,
      endsAt: Date.now() + cycleMs * batches,
    };
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    this.emit({ type: 'lifeskill-changed' });
    this.emit({ type: 'notice', message: 'A produzir: ' + recipe.name + ' x' + batches + '.', level: 'info' });
    return true;
  }

  cancelActivity(): void {
    if (!this.activity) return;
    const msg = this.activity.kind === 'gathering' ? 'Recolha cancelada.' : 'Producao cancelada. Materiais nao usados foram perdidos.';
    this.activity = null;
    this.emit({ type: 'lifeskill-changed' });
    this.emit({ type: 'notice', message: msg, level: 'warn' });
  }

  tickLifeskill(nowMs: number): void {
    const act = this.activity;
    if (!act) return;
    const elapsed = nowMs - act.startedAt;
    if (elapsed < 0) return;
    const cyclesElapsed = Math.floor(elapsed / act.cycleMs);
    const target = Math.min(cyclesElapsed, act.batches);
    let processed = 0;
    let completed = act.completedActions;
    let activityEnded = false;
    while (completed < target && processed < MAX_SIM_CYCLES_PER_TICK) {
      const ok = this.runOneCycle(act);
      completed += 1;
      processed += 1;
      if (!ok) { activityEnded = true; break; }
    }
    this.activity = { ...act, completedActions: completed };
    if (completed >= act.batches || activityEnded) {
      this.activity = null;
      this.emit({ type: 'lifeskill-changed' });
      this.emit({ type: 'notice', message: 'Atividade concluida.', level: 'info' });
    } else if (processed > 0) {
      this.emit({ type: 'lifeskill-changed' });
    }
  }

  private runOneCycle(act: ActivityState): boolean {
    if (act.kind === 'gathering') {
      const node = this.registry.getNode(act.targetId as NodeId);
      if (!node) return false;
      const tool = this.getEquippedTool();
      const profState = this.getProfessionState(node.professionId);
      const yieldBonus = this.buffModifier('gather-yield') + this.getGatherYieldBonus();
      const yieldResult = performGatherAction({
        node, tool, mastery: profState.mastery, professionLevel: profState.level, rng: this.rng,
      });
      if (!yieldResult) return false;
      for (const d of yieldResult.drops) {
        const qty = yieldBonus > 0 ? Math.max(d.quantity, Math.floor(d.quantity * (1 + yieldBonus))) : d.quantity;
        const def = this.registry.getItem(d.itemId);
        if (!def) continue;
        this.inventory.add(d.itemId, qty, def.maxStack, 0);
      }
      if (tool && yieldResult.durabilityCost > 0) {
        const current = this.equipment.get('tool');
        if (current && current.durability !== null) {
          const nextDur = Math.max(0, current.durability - yieldResult.durabilityCost);
          this.equipment.setSlot('tool', { ...current, durability: nextDur });
          if (nextDur === 0) this.emit({ type: 'notice', message: 'Ferramenta sem durabilidade.', level: 'warn' });
        }
      }
      const prof = this.registry.getProfession(node.professionId);
      if (prof) {
        const lr = addProfessionExperience(profState, yieldResult.expGained, prof.maxLevel, prof.masteryPerLevel);
        this.professionStates.set(node.professionId, lr.state);
        if (lr.levelsGained > 0) this.emit({ type: 'notice', message: prof.name + ' subiu para nivel ' + lr.state.level + '!', level: 'info' });
      }
      this.triggerTutorial({ kind: 'gather-node', targetId: node.id as string, amount: 1 });
      this.triggerQuest({ kind: 'gather-node', targetId: node.id as string, amount: 1 });
      this.emit({ type: 'inventory-changed' });
      this.emit({ type: 'equipment-changed' });
      return true;
    }
    const recipe = this.registry.getRecipe(act.targetId as RecipeId);
    if (!recipe) return false;
    const profState = this.getProfessionState(recipe.professionId);
    const yieldMult = masteryYieldMultiplier(profState.mastery);
    const outputs = rollOutputs(recipe.outputs, 1, this.rng, yieldMult);
    for (const o of outputs) {
      const def = this.registry.getItem(o.itemId);
      if (!def) continue;
      const dur = isTool(def) ? def.maxDurability : null;
      const res = this.inventory.add(o.itemId, o.quantity, def.maxStack, 0);
      if (dur !== null && res.added > 0) {
        const list = this.inventory.list();
        for (let i = 0; i < list.length; i++) {
          const s = list[i];
          if (s && s.itemId === o.itemId && s.durability === null) {
            this.inventory.setAt(i, { ...s, durability: dur });
            break;
          }
        }
      }
    }
    const prof = this.registry.getProfession(recipe.professionId);
    if (prof) {
      const lr = addProfessionExperience(profState, recipe.baseExp, prof.maxLevel, prof.masteryPerLevel);
      this.professionStates.set(recipe.professionId, lr.state);
      if (lr.levelsGained > 0) this.emit({ type: 'notice', message: prof.name + ' subiu para nivel ' + lr.state.level + '!', level: 'info' });
    }
    this.triggerTutorial({ kind: 'craft-recipe', targetId: recipe.id as string, amount: 1 });
    this.triggerQuest({ kind: 'craft-recipe', targetId: recipe.id as string, amount: 1 });
    this.emit({ type: 'inventory-changed' });
    return true;
  }

  /* ==================== Combate ==================== */

  startCombat(zoneId: ZoneId): boolean {
    if (this.activity) { this.emit({ type: 'notice', message: 'Termina a atividade atual primeiro.', level: 'warn' }); return false; }
    const zone = this.registry.getZone(zoneId);
    if (!zone) { this.emit({ type: 'notice', message: 'Zona desconhecida.', level: 'error' }); return false; }
    if (this.character.level < zone.minLevel) { this.emit({ type: 'notice', message: 'Requer nivel ' + zone.minLevel + '.', level: 'warn' }); return false; }
    const _derivedForGate = this.getDerivedStats();
    const _scaling = computeZoneScaling(_derivedForGate.ap, _derivedForGate.dp, zone);
    if (_scaling.status === 'weak' || _scaling.status === 'severely-weak') {
      this.emit({ type: 'notice', message: 'Aviso: ' + _scaling.description, level: 'warn' });
    }
    this.currentZoneScaling = _scaling;
    this.triggerTutorial({ kind: 'enter-zone', targetId: zoneId as string, amount: 1 });
    this.triggerQuest({ kind: 'enter-zone', targetId: zoneId as string, amount: 1 });
    this.currentZoneId = zoneId;
    this.sessionKills = 0; this.sessionXp = 0; this.sessionSilver = 0;
    this.sessionLoot = new Map(); this.combatLog = []; this.pausedUntilMs = 0;
    this.spawnNextMonster(Date.now());
    this.emit({ type: 'combat-changed' });
    return true;
  }

  stopCombat(): void {
    this.combatState = null; this.currentZoneId = null; this.currentMonsterId = null;
    this.currentZoneScaling = null;
    this.combatLog = [];
    this.emit({ type: 'combat-changed' });
  }

  setCombatConfig(patch: Partial<CombatConfig>): void {
    this.combatConfig = { ...this.combatConfig, ...patch };
    this.emit({ type: 'combat-changed' });
  }

  tickCombat(nowMs: number, deltaMs: number): void {
    const expired = this.buffs.tick(nowMs);
    if (expired.length > 0) this.emit({ type: 'buff-changed' });

    if (!this.combatState || !this.currentZoneId || !this.currentMonsterId) return;
    if (deltaMs <= 0) return;
    if (this.dungeonsService.isActive() && this.dungeonsService.checkTimeout(nowMs)) {
      this.emit({ type: 'notice', message: 'Tempo esgotado! Dungeon falhada.', level: 'error' });
      this.combatState = null;
      this.currentMonsterId = null;
      this.emit({ type: 'dungeon-changed' });
      this.emit({ type: 'combat-changed' });
      return;
    }
    const dt = Math.min(deltaMs, MAX_TICK_MS);
    if (nowMs < this.pausedUntilMs) return;
    if (this.combatState.outcome !== 'ongoing') { this.spawnNextMonster(nowMs); return; }
    const monsterDef = this.registry.getMonster(this.currentMonsterId);
    if (!monsterDef) { this.stopCombat(); return; }
    const player = this.buildPlayerInput();
    const monster = this.buildMonsterInput(monsterDef);
    const result = tickCombat({ state: this.combatState, deltaMs: dt, player, monster, config: this.combatConfig, rng: this.rng });
    this.combatState = result.state;

    const derivedForRegen = this.getDerivedStats();
    const hpRegen = (this.buffModifier('hp-regen') + derivedForRegen.hpRegenPerSec) * (dt / 1000);
    const resRegen = this.buffModifier('resource-regen') * (dt / 1000);
    if (hpRegen > 0 || resRegen > 0) {
      this.combatState = {
        ...this.combatState,
        playerHp: Math.min(player.maxHp, this.combatState.playerHp + hpRegen),
        playerResource: Math.min(player.maxResource, this.combatState.playerResource + resRegen),
      };
    }

    for (const ev of result.events) this.combatLog.push(ev);
    this.combatLog = this.combatLog.slice(-LOG_CAPACITY);
    this.syncCharacterFromCombat();
    if (result.state.outcome === 'victory') this.handleVictory(monsterDef, nowMs);
    else if (result.state.outcome === 'defeat') this.handleDefeat(nowMs);
    this.emit({ type: 'combat-changed' });
  }

  private buildPlayerInput(): PlayerCombatInput {
    const d = this.getDerivedStats();
    return {
      attack: Math.max(1, Math.floor(d.attack * (this.currentZoneScaling?.damageDealtMult ?? 1))),
      defense: d.defense,
      critChance: d.criticalChance,
      critDamageMultiplier: this.getCritDamageMultiplier(),
      maxHp: d.maxHp, maxResource: d.maxResource,
      resourceRegenPerSec: PLAYER_RESOURCE_REGEN_PER_SEC,
      lifesteal: d.lifesteal,
      attackIntervalMs: PLAYER_ATTACK_INTERVAL_MS,
      skills: this.getPlayerSkills(),
    };
  }

  private buildMonsterInput(def: MonsterDefinition): MonsterCombatInput {
    const taken = this.currentZoneScaling?.damageTakenMult ?? 1;
    return {
      attack: Math.max(1, Math.floor(def.attack * taken)),
      defense: def.defense,
      maxHp: def.maxHp,
      attackIntervalMs: def.attackIntervalMs,
    };
  }

