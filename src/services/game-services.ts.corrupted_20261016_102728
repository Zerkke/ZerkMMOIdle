  /* ==================== Idle / Offline ==================== */

  getIdleSetup(): IdleSetup | null { return this.idleSetup; }

  setIdleSetup(setup: IdleSetup | null): void {
    this.idleSetup = setup;
    this.emit({ type: 'idle-changed' });
  }

  getLastIdleReport(): IdleReport | null { return this.lastIdleReport; }

  clearLastIdleReport(): void {
    this.lastIdleReport = null;
    this.emit({ type: 'idle-changed' });
  }

  /**
   * Simula o tempo decorrido entre `fromMs` e `toMs` usando o setup guardado.
   * Chamado pelo main.ts ao carregar o save.
   */
  runIdleCatchup(fromMs: number, toMs: number): IdleReport | null {
    const setup = this.idleSetup;
    if (!setup) return null;
    const rawElapsed = toMs - fromMs;
    if (rawElapsed <= 0) return null;
    const cappedMs = Math.min(rawElapsed, MAX_OFFLINE_MS);
    const wasCapped = rawElapsed > cappedMs;
    const seed = deriveSeed(Math.floor(fromMs / 1000), this.character.level);
    const rng = new SeededRng(seed);

    let report: IdleReport;
    if (setup.activity.kind === 'combat') {
      report = this.runIdleCombat(setup, fromMs, toMs, cappedMs, wasCapped, rng);
    } else if (setup.activity.kind === 'gathering') {
      report = this.runIdleGathering(setup, fromMs, toMs, cappedMs, wasCapped, rng);
    } else {
      report = this.runIdleProduction(setup, fromMs, toMs, cappedMs, wasCapped, rng);
    }

    this.lastIdleReport = report;
    this.emit({ type: 'idle-changed' });
    this.emit({ type: 'inventory-changed' });
    this.emit({ type: 'character-changed' });
    return report;
  }

  private runIdleCombat(setup: IdleSetup, fromMs: number, toMs: number, cappedMs: number, wasCapped: boolean, rng: SeededRng): IdleReport {
    const cfg = setup.activity;
    if (cfg.kind !== 'combat') throw new Error('config nao e combate');
    const zone = this.registry.getZone(cfg.zoneId);
    if (!zone) {
      return emptyReport(fromMs, toMs, cappedMs, wasCapped, cfg, 'stopped-dead', 'Zona inexistente.');
    }
    const player = this.getDerivedStats();
    const monsters: CombatIdleMonster[] = [];
    for (const mid of zone.monsters) {
      const m = this.registry.getMonster(mid);
      if (!m) continue;
      const dmgPerHit = computeDamage({ attack: player.attack, multiplier: 1, defense: m.defense, critChance: player.criticalChance, rng: () => 0.5 }).damage;
      const hitsToKill = Math.max(1, Math.ceil(m.maxHp / dmgPerHit));
      const killTimeMs = hitsToKill * PLAYER_ATTACK_INTERVAL_MS;
      const monsterHits = Math.max(1, Math.ceil(killTimeMs / m.attackIntervalMs));
      const monsterDmg = computeDamage({ attack: m.attack, multiplier: 1, defense: player.defense, critChance: 0, rng: () => 0.5 }).damage;
      const hpLossPerKill = monsterHits * monsterDmg;
      monsters.push({
        monsterId: m.id as string,
        weight: 1,
        killTimeMs,
        hpLossPerKill,
        expReward: m.expReward,
        silverReward: m.silverReward,
        loot: m.loot.map((l) => ({ itemId: l.itemId as string, chance: l.chance, min: l.minQuantity, max: l.maxQuantity })),
      });
    }

    // Contar pocoes HP no inventario
    let hpItems = 0;
    let hpItemId: ItemId | null = null;
    let healAmount = 0;
    for (const stack of this.inventory.list()) {
      if (!stack) continue;
      const def = this.registry.getItem(stack.itemId);
      if (!def) continue;
      if (def.appliesBuffId === null) continue;
      const buff = this.registry.getBuff(def.appliesBuffId);
      if (buff && buff.kind === 'hp-regen') {
        hpItems += stack.quantity;
        hpItemId = stack.itemId;
        healAmount = Math.max(healAmount, buff.magnitude * (buff.durationMs / 1000));
      }
    }

    const outcome = simulateCombat({
      monsters,
      playerMaxHp: player.maxHp,
      playerHpAtStart: this.character.hp,
      hpRecoveryPerKill: 5,
      maxHpItems: hpItems,
      hpItemHealAmount: healAmount,
      hpItemThreshold: setup.autoHpThreshold,
    }, cappedMs, rng);

    // Aplicar resultados
    const xpPrev = this.character.level;
    this.character = applyExperience(this.character, outcome.xpGained).state;
    this.character = addSilver(this.character, outcome.silverGained);
    if (this.character.level > xpPrev) {
      const d = this.getDerivedStats();
      this.character = { ...this.character, hp: d.maxHp, resource: d.maxResource };
    }
    for (const entry of outcome.loot) {
      const itemId = asItemId(entry.itemId);
      const def = this.registry.getItem(itemId);
      if (!def) continue;
      this.inventory.add(itemId, entry.quantity, def.maxStack, 0);
    }
    if (outcome.hpItemsUsed > 0 && hpItemId) {
      this.inventory.remove(hpItemId, outcome.hpItemsUsed);
    }
    this.ledger.record('combat', outcome.silverGained, outcome.loot.map((l) => ({ itemId: asItemId(l.itemId), delta: l.quantity })), 'Idle combat: ' + outcome.kills + ' kills', toMs);

    const stoppedMsg = outcome.stoppedReason === 'dead' ? 'Foste derrotado.'
      : outcome.stoppedReason === 'no-hp-item' ? 'Pocoes esgotadas.'
      : wasCapped ? 'Tempo limitado ao maximo offline (8h).'
      : 'Concluido.';

    return {
      startedAt: fromMs, endedAt: toMs, simulatedMs: cappedMs, cappedMs, wasCapped,
      config: cfg, outcome: outcome.stoppedReason === 'dead' ? 'stopped-dead'
        : outcome.stoppedReason === 'no-hp-item' ? 'stopped-no-hp-item'
        : 'completed',
      xpGained: outcome.xpGained, silverGained: outcome.silverGained,
      loot: outcome.loot, kills: outcome.kills, actions: 0, batches: 0,
      consumablesUsed: outcome.hpItemsUsed, notes: stoppedMsg,
    };
  }

  private runIdleGathering(setup: IdleSetup, fromMs: number, toMs: number, cappedMs: number, wasCapped: boolean, rng: SeededRng): IdleReport {
    const cfg = setup.activity;
    if (cfg.kind !== 'gathering') throw new Error('config nao e gathering');
    const node = this.registry.getNode(cfg.nodeId);
    if (!node) return emptyReport(fromMs, toMs, cappedMs, wasCapped, cfg, 'stopped-no-tool', 'No inexistente.');

    const check = this.canGatherAt(cfg.nodeId);
    if (!check.ok) return emptyReport(fromMs, toMs, cappedMs, wasCapped, cfg, 'stopped-no-tool', check.reason ?? 'Sem ferramenta.');

    const profState = this.getProfessionState(node.professionId);
    const speedBonus = this.buffModifier('gather-speed');
    const adjustedBase = Math.max(200, node.baseTimeMs * (1 - speedBonus));
    const cycleMs = effectiveActionTimeMs(adjustedBase, profState.mastery, check.tool);

    const outcome = simulateGathering({
      cycleMs,
      expPerCycle: node.baseExp,
      loot: node.loot.map((l) => ({ itemId: l.itemId as string, chance: l.chance, min: l.minQuantity, max: l.maxQuantity })),
      toolDurability: check.tool?.durability ?? 0,
      durabilityPerCycle: check.tool ? 1 : 0,
      inventoryFreeSlots: this.inventory.capacity - this.inventory.usedSlots(),
    }, cappedMs, rng);

    for (const entry of outcome.loot) {
      const itemId = asItemId(entry.itemId);
      const def = this.registry.getItem(itemId);
      if (!def) continue;
      this.inventory.add(itemId, entry.quantity, def.maxStack, 0);
    }
    // Gastar durabilidade
    if (outcome.durabilitySpent > 0 && check.tool) {
      const current = this.equipment.get('tool');
      if (current && current.durability !== null) {
        this.equipment.setSlot('tool', { ...current, durability: Math.max(0, current.durability - outcome.durabilitySpent) });
      }
    }
    const prof = this.registry.getProfession(node.professionId);
    if (prof) {
      const lr = addProfessionExperience(profState, outcome.xpGained, prof.maxLevel, prof.masteryPerLevel);
      this.professionStates.set(node.professionId, lr.state);
    }
    this.ledger.record('profession', 0, outcome.loot.map((l) => ({ itemId: asItemId(l.itemId), delta: l.quantity })), 'Idle gathering: ' + outcome.actions + ' acoes', toMs);

    const stoppedMsg = outcome.stoppedReason === 'tool-broken' ? 'Ferramenta quebrou.'
      : outcome.stoppedReason === 'inventory-full' ? 'Inventario cheio.'
      : wasCapped ? 'Tempo limitado ao maximo offline (8h).'
      : 'Concluido.';

    return {
      startedAt: fromMs, endedAt: toMs, simulatedMs: cappedMs, cappedMs, wasCapped,
      config: cfg, outcome: outcome.stoppedReason === 'tool-broken' ? 'stopped-tool-broken'
        : outcome.stoppedReason === 'inventory-full' ? 'stopped-inventory-full'
        : 'completed',
      xpGained: outcome.xpGained, silverGained: 0,
      loot: outcome.loot, kills: 0, actions: outcome.actions, batches: 0,
      consumablesUsed: 0, notes: stoppedMsg,
    };
  }

  private runIdleProduction(setup: IdleSetup, fromMs: number, toMs: number, cappedMs: number, wasCapped: boolean, rng: SeededRng): IdleReport {
    const cfg = setup.activity;
    if (cfg.kind !== 'production') throw new Error('config nao e production');
    const recipe = this.registry.getRecipe(cfg.recipeId);
    if (!recipe) return emptyReport(fromMs, toMs, cappedMs, wasCapped, cfg, 'stopped-no-materials', 'Receita inexistente.');

    const profState = this.getProfessionState(recipe.professionId);
    if (profState.level < recipe.requiredLevel) {
      return emptyReport(fromMs, toMs, cappedMs, wasCapped, cfg, 'stopped-no-materials', 'Nivel insuficiente.');
    }
    const speedBonus = this.buffModifier('craft-speed');
    const cycleMs = Math.max(200, Math.floor(recipe.baseTimeMs * (1 - Math.min(0.4, profState.mastery * 0.001)) * (1 - speedBonus)));

    // Inventario como mapa itemId->quantidade
    const inventoryMap = new Map<string, number>();
    for (const stack of this.inventory.list()) {
      if (!stack) continue;
      inventoryMap.set(stack.itemId as string, (inventoryMap.get(stack.itemId as string) ?? 0) + stack.quantity);
    }

    const outcome = simulateProduction({
      cycleMs,
      batchesPerCycle: cfg.batchesPerCycle,
      expPerCycle: recipe.baseExp,
      inputsPerCycle: recipe.inputs.map((i) => ({ itemId: i.itemId as string, quantity: i.quantity })),
      outputsPerCycle: recipe.outputs.map((o) => ({ itemId: o.itemId as string, quantity: o.quantity, chance: o.chance })),
      inventory: inventoryMap,
    }, cappedMs, rng);

    // Consumir inputs
    for (const c of outcome.consumed) {
      const itemId = asItemId(c.itemId);
      this.inventory.remove(itemId, c.quantity);
    }
    // Adicionar outputs
    for (const p of outcome.produced) {
      const itemId = asItemId(p.itemId);
      const def = this.registry.getItem(itemId);
      if (!def) continue;
      this.inventory.add(itemId, p.quantity, def.maxStack, 0);
    }
    const prof = this.registry.getProfession(recipe.professionId);
    if (prof) {
      const lr = addProfessionExperience(profState, outcome.xpGained, prof.maxLevel, prof.masteryPerLevel);
      this.professionStates.set(recipe.professionId, lr.state);
    }
    // Custo de prata
    const silverCost = recipe.silverCost * outcome.batches;
    if (silverCost > 0 && this.character.silver >= silverCost) {
      this.character = addSilver(this.character, -silverCost);
    }
    this.ledger.record('crafting', -silverCost, outcome.produced.map((p) => ({ itemId: asItemId(p.itemId), delta: p.quantity })), 'Idle crafting: ' + outcome.cycles + ' ciclos', toMs);

    const stoppedMsg = outcome.stoppedReason === 'no-materials' ? 'Faltaram materiais.'
      : wasCapped ? 'Tempo limitado ao maximo offline (8h).'
      : 'Concluido.';

    return {
      startedAt: fromMs, endedAt: toMs, simulatedMs: cappedMs, cappedMs, wasCapped,
      config: cfg, outcome: outcome.stoppedReason === 'no-materials' ? 'stopped-no-materials' : 'completed',
      xpGained: outcome.xpGained, silverGained: -silverCost,
      loot: outcome.produced, kills: 0, actions: 0, batches: outcome.batches,
      consumablesUsed: 0, notes: stoppedMsg,
    };
  }
