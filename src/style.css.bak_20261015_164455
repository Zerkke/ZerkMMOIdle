/* ===== ZERK DESIGN SYSTEM v1 ===== */
:root {
  --zk-bg-0: #0a0912;
  --zk-bg-1: #12101c;
  --zk-bg-2: #1a1822;
  --zk-bg-3: #252038;
  --zk-bg-4: #322a48;
  --zk-gold: #e8c977;
  --zk-gold-2: #b89947;
  --zk-gold-3: #8a6f30;
  --zk-purple: #6a4a9a;
  --zk-purple-2: #4a2f7a;
  --zk-blue: #4878d8;
  --zk-red: #d84848;
  --zk-green: #6cc46c;
  --zk-border: rgba(180,150,60,0.35);
  --zk-border-soft: rgba(180,150,60,0.18);
  --zk-border-strong: rgba(232,201,119,0.6);
  --zk-text: #e6e1d3;
  --zk-text-dim: rgba(230,225,211,0.7);
  --zk-text-mute: rgba(230,225,211,0.5);
  --zk-r-1: 4px;
  --zk-r-2: 6px;
  --zk-r-3: 10px;
  --zk-r-4: 14px;
  --zk-glow-gold: 0 0 12px rgba(232,201,119,0.4);
  --zk-glow-gold-strong: 0 0 20px rgba(232,201,119,0.6);
  --zk-inset: inset 0 1px 0 rgba(255,255,255,0.05);
  --zk-rarity-common: rgba(154,140,184,0.4);
  --zk-rarity-uncommon: rgba(106,184,122,0.7);
  --zk-rarity-rare: rgba(90,159,212,0.85);
  --zk-rarity-epic: rgba(168,98,204,0.9);
  --zk-rarity-legendary: rgba(232,168,70,1);
}

html, body {
  background:
    radial-gradient(ellipse at top, rgba(106,74,154,0.08), transparent 60%),
    radial-gradient(ellipse at bottom, rgba(180,150,60,0.05), transparent 60%),
    var(--zk-bg-0);
  color: var(--zk-text);
  min-height: 100vh;
}

* {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-track { background: rgba(10,9,18,0.6); border-radius: 10px; }
::-webkit-scrollbar-thumb {
  background: linear-gradient(180deg, var(--zk-gold-2), var(--zk-gold-3));
  border-radius: 10px;
  border: 2px solid rgba(10,9,18,0.6);
}
::-webkit-scrollbar-thumb:hover {
  background: linear-gradient(180deg, var(--zk-gold), var(--zk-gold-2));
  box-shadow: var(--zk-glow-gold);
}

.panel-content { animation: zkFadeIn 0.25s ease-out; }
@keyframes zkFadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to   { opacity: 1; transform: translateY(0); }
}

.panel-content h2 {
  color: var(--zk-gold);
  letter-spacing: 2px;
  font-size: 20px;
  text-shadow: 0 0 12px rgba(232,201,119,0.35);
  border-bottom: 1px solid var(--zk-border);
  padding-bottom: 8px;
  margin-bottom: 14px;
}

.panel-content h3 {
  color: var(--zk-gold);
  text-shadow: 0 0 8px rgba(232,201,119,0.2);
  letter-spacing: 1px;
}

button, .action-button {
  transition: transform 0.15s, box-shadow 0.15s, background 0.15s, border-color 0.15s;
}
button:not(:disabled):hover { transform: translateY(-1px); }

.item-cell {
  transition: transform 0.15s, box-shadow 0.15s, border-color 0.15s;
  position: relative;
}
.item-cell:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 12px var(--rarity-glow, rgba(232,201,119,0.3)), 0 4px 10px rgba(0,0,0,0.5);
  z-index: 2;
}

.info-row { border-bottom: 1px dotted rgba(180,150,60,0.15); padding: 6px 0; }
.info-row:last-child { border-bottom: none; }

button:focus-visible, input:focus-visible, select:focus-visible {
  outline: 2px solid var(--zk-gold);
  outline-offset: 2px;
}

::selection { background: rgba(232,201,119,0.35); color: var(--zk-text); }

input[type="text"], input[type="number"], select, textarea {
  background: rgba(15,14,24,0.7);
  color: var(--zk-text);
  border: 1px solid var(--zk-border);
  border-radius: var(--zk-r-2);
  padding: 6px 10px;
  transition: border-color 0.15s, box-shadow 0.15s;
}
input[type="text"]:focus, input[type="number"]:focus, select:focus, textarea:focus {
  border-color: var(--zk-gold);
  box-shadow: var(--zk-glow-gold);
  outline: none;
}

.zk-frame {
  position: relative;
  background: linear-gradient(180deg, rgba(30,26,45,0.9), rgba(18,16,26,0.95));
  border: 1px solid var(--zk-border);
  border-radius: var(--zk-r-3);
  box-shadow: var(--zk-inset), 0 4px 20px rgba(0,0,0,0.5);
}
.zk-frame::before, .zk-frame::after {
  content: "";
  position: absolute;
  width: 20px;
  height: 20px;
  border: 2px solid var(--zk-gold-2);
  pointer-events: none;
}
.zk-frame::before { top: 4px; left: 4px; border-right: none; border-bottom: none; border-top-left-radius: 6px; }
.zk-frame::after { bottom: 4px; right: 4px; border-left: none; border-top: none; border-bottom-right-radius: 6px; }

.zk-title {
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 3px;
  color: var(--zk-gold);
  text-shadow: 0 0 10px rgba(232,201,119,0.4);
  text-transform: uppercase;
}

.zk-divider {
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--zk-border), transparent);
  margin: 12px 0;
}

