:root {
  --color-bg: #0d0a1a;
  --color-surface: #1a1430;
  --color-surface-alt: #221a3a;
  --color-border: #3a2f5a;
  --color-border-strong: #5a4a8a;
  --color-text: #e8e0f0;
  --color-text-muted: #9a8cb8;
  --color-accent: #d4a24e;
  --color-accent-hover: #e8b86a;
  --color-danger: #c94a5a;
  --color-success: #6ab87a;
  --color-warn: #d4a24e;
  --font-main: "EB Garamond", Georgia, "Times New Roman", serif;
  --font-display: "Cinzel", Georgia, serif;
  --header-height: 56px;
  --tabs-height: 40px;
  --banner-height: 84px;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  width: 100%;
  height: 100%;
  font-family: var(--font-main);
  background: var(--color-bg);
  color: var(--color-text);
  overflow: hidden;
}

/* ==================== APP LAYOUT ==================== */

#app {
  display: grid;
  grid-template-rows: var(--header-height) var(--tabs-height) 1fr;
  grid-template-areas: "header" "tabs" "main";
  width: 100%;
  height: 100vh;
  height: 100dvh;
  overflow: hidden;
}

/* ==================== HEADER ==================== */

#game-header {
  grid-area: header;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  gap: 16px;
  background: linear-gradient(180deg, #1a1430 0%, #120c24 100%);
  border-bottom: 1px solid var(--color-border-strong);
  z-index: 20;
}

.header-brand {
  display: flex;
  align-items: baseline;
  gap: 12px;
  flex-shrink: 0;
}

.header-brand h1 {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--color-accent);
  letter-spacing: 1px;
  text-shadow: 0 0 12px rgba(212, 162, 78, 0.35);
}

#game-version {
  font-size: 0.7rem;
  color: var(--color-text-muted);
  font-style: italic;
}

.buff-bar-host { display: flex; justify-content: center; flex: 1; min-width: 0; }
.buff-bar { display: flex; gap: 6px; flex-wrap: wrap; max-width: 100%; }

.buff-chip {
  display: flex; flex-direction: column; align-items: center;
  padding: 2px 8px; background: rgba(212, 162, 78, 0.12);
  border: 1px solid rgba(212, 162, 78, 0.4); border-radius: 4px;
  line-height: 1.1;
}

.buff-chip__name { font-size: 0.68rem; color: var(--color-accent); font-weight: 600; }
.buff-chip__time { font-size: 0.6rem; color: var(--color-text-muted); }

.resource-bar-host {
  flex-shrink: 0;
  display: flex;
  justify-content: flex-end;
  min-width: 0;
}

.resource-bar { display: flex; gap: 20px; align-items: center; }
.resource-bar__item { display: flex; flex-direction: column; align-items: flex-end; line-height: 1.1; }
.resource-bar__label {
  font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: var(--color-text-muted);
}
.resource-bar__value { font-size: 0.9rem; font-weight: 600; color: var(--color-accent); }

/* ==================== TABS ==================== */

#tab-nav {
  grid-area: tabs;
  display: flex;
  overflow-x: auto;
  background: var(--color-surface);
  border-bottom: 1px solid var(--color-border);
  scrollbar-width: thin;
  z-index: 19;
}

#tab-nav::-webkit-scrollbar { height: 4px; }
#tab-nav::-webkit-scrollbar-thumb { background: var(--color-border-strong); }

.tab-button {
  flex-shrink: 0;
  padding: 0 20px;
  height: 100%;
  background: transparent;
  border: none;
  border-bottom: 2px solid transparent;
  color: var(--color-text-muted);
  font-family: var(--font-main);
  font-size: 0.82rem;
  font-weight: 500;
  cursor: pointer;
  transition: color 0.15s, border-color 0.15s, background 0.15s;
  white-space: nowrap;
}

.tab-button:hover {
  color: var(--color-text);
  background: rgba(212, 162, 78, 0.05);
}

.tab-button--active {
  color: var(--color-accent);
  border-bottom-color: var(--color-accent);
  background: rgba(212, 162, 78, 0.08);
}

/* ==================== MAIN ==================== */

#game-main {
  grid-area: main;
  display: grid;
  grid-template-rows: var(--banner-height) 1fr;
  grid-template-areas: "banner" "panel";
  overflow: hidden;
}

/* ==================== ACTIVITY BANNER ==================== */

.activity-banner-host {
  grid-area: banner;
  background: linear-gradient(180deg, #14102a 0%, #0d0a1a 100%);
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
  z-index: 10;
}

.activity-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 0 24px;
  height: 100%;
  transition: background 0.3s;
}

.activity-banner--combat {
  background: linear-gradient(180deg, rgba(201, 74, 90, 0.06) 0%, transparent 100%);
  border-left: 3px solid var(--color-danger);
}

.activity-banner--lifeskill {
  background: linear-gradient(180deg, rgba(106, 184, 122, 0.06) 0%, transparent 100%);
  border-left: 3px solid var(--color-success);
}

.activity-banner--idle {
  background: linear-gradient(180deg, rgba(154, 140, 184, 0.04) 0%, transparent 100%);
  border-left: 3px solid var(--color-border-strong);
}

.activity-banner__left {
  display: flex;
  align-items: center;
  gap: 16px;
  flex: 1;
  min-width: 0;
}

.activity-banner__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 8px;
  font-size: 1.6rem;
  flex-shrink: 0;
  border: 1px solid var(--color-border-strong);
}

.activity-banner__icon--combat { background: rgba(201, 74, 90, 0.15); color: #e088a0; }
.activity-banner__icon--lifeskill { background: rgba(106, 184, 122, 0.15); color: #a8e0b8; }
.activity-banner__icon--idle { background: rgba(154, 140, 184, 0.1); color: var(--color-text-muted); }

.activity-banner__info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.activity-banner__title {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-text);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.activity-banner__sub {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.activity-banner__right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
  min-width: 320px;
  justify-content: flex-end;
}

.activity-banner__bar-row {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 200px;
}

.activity-banner__bar-label {
  font-size: 0.68rem;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  min-width: 30px;
  font-weight: 600;
}

.activity-banner__bar-track {
  flex: 1;
  height: 12px;
  background: rgba(13, 10, 26, 0.85);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  overflow: hidden;
  position: relative;
}

.activity-banner__bar-fill {
  height: 100%;
  transition: width 0.35s ease-out;
  border-radius: 6px;
}

.activity-banner__bar-fill--enemy { background: linear-gradient(90deg, #8a2a3a, #c94a5a); }
.activity-banner__bar-fill--player { background: linear-gradient(90deg, #3a8a4a, #6ab87a); }
.activity-banner__bar-fill--progress { background: linear-gradient(90deg, #3a5a8a, #7ad4ff); }

.activity-banner__bar-text {
  font-size: 0.72rem;
  color: var(--color-text);
  font-weight: 600;
  min-width: 70px;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* ==================== PANEL ==================== */

#side-panel-content {
  grid-area: panel;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 20px 24px 100px;
  background:
    radial-gradient(ellipse at top, rgba(212, 162, 78, 0.03) 0%, transparent 60%),
    var(--color-bg);
}

#side-panel-content::-webkit-scrollbar { width: 10px; }
#side-panel-content::-webkit-scrollbar-track { background: rgba(13, 10, 26, 0.5); }
#side-panel-content::-webkit-scrollbar-thumb {
  background: var(--color-border-strong);
  border-radius: 5px;
}
#side-panel-content::-webkit-scrollbar-thumb:hover { background: var(--color-accent); }

/* Grid layout for wide screens */
.panel-content {
  max-width: 1400px;
  margin: 0 auto;
}

.panel-content h2 {
  font-family: var(--font-display);
  font-size: 1.4rem;
  color: var(--color-accent);
  margin-bottom: 18px;
  padding-bottom: 10px;
  letter-spacing: 0.5px;
  border-bottom: 1px solid var(--color-border);
}

.panel-content h3 {
  font-size: 0.8rem;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin: 20px 0 10px;
}

.panel-content h4 {
  font-size: 0.85rem;
  color: var(--color-text);
  margin: 12px 0 6px;
}

/* ==================== INFO GRID ==================== */

.info-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 6px 24px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.88rem;
  padding: 6px 0;
  border-bottom: 1px dashed rgba(154, 140, 184, 0.15);
}

.info-row__label { color: var(--color-text-muted); }
.info-row__value { color: var(--color-text); font-weight: 500; }

.muted {
  color: var(--color-text-muted);
  font-size: 0.82rem;
  font-style: italic;
  margin-top: 12px;
  line-height: 1.5;
}

/* ==================== ZONE CARD ==================== */

.zone-card {
  background: rgba(13, 10, 26, 0.6);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 14px;
}

.zone-card h3 {
  font-family: var(--font-display);
  font-size: 1.05rem;
  color: var(--color-accent);
  margin: 0 0 6px;
  text-transform: none;
  letter-spacing: 0;
}

.zone-card p { font-size: 0.85rem; margin-bottom: 6px; }

.monster-list { list-style: none; margin-top: 10px; padding-left: 0; }
.monster-list li {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  padding: 4px 0 4px 16px;
  position: relative;
}
.monster-list li::before {
  content: "â€º";
  position: absolute;
  left: 0;
  color: var(--color-accent);
  font-size: 1rem;
}

/* ==================== PANEL STATES ==================== */

.panel-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 10px; padding: 60px 20px; text-align: center;
  border-radius: 8px; font-size: 0.9rem;
}

.panel-state--error {
  color: var(--color-danger);
  border: 1px solid var(--color-danger);
  background: rgba(201, 74, 90, 0.08);
}

.panel-state--empty {
  color: var(--color-text-muted);
  border: 1px dashed var(--color-border);
  background: rgba(13, 10, 26, 0.4);
}

.panel-state strong {
  font-family: var(--font-display);
  font-size: 1.1rem;
  color: var(--color-accent);
  letter-spacing: 1px;
}

.panel-state p { max-width: 320px; line-height: 1.5; }

/* ==================== ACTION BUTTONS ==================== */

.action-button {
  padding: 8px 14px;
  background: var(--color-surface);
  color: var(--color-text);
  border: 1px solid var(--color-border-strong);
  border-radius: 5px;
  font-family: var(--font-main);
  font-size: 0.82rem;
  cursor: pointer;
  transition: background 0.15s, border-color 0.15s, color 0.15s;
}

.action-button:hover:not(:disabled) {
  background: var(--color-surface-alt);
  border-color: var(--color-accent);
  color: var(--color-accent);
}

.action-button:disabled { opacity: 0.45; cursor: not-allowed; }

.action-button--active {
  border-color: var(--color-accent);
  color: var(--color-accent);
  background: rgba(212, 162, 78, 0.12);
}

.action-button--danger {
  border-color: var(--color-danger);
  color: var(--color-danger);
}

.action-button--danger:hover {
  background: rgba(201, 74, 90, 0.15);
  color: #ff8a9a;
}

.action-button--primary {
  background: var(--color-accent);
  color: #1a0f00;
  border-color: var(--color-accent);
  font-weight: 600;
}

.action-button--primary:hover:not(:disabled) {
  background: var(--color-accent-hover);
  border-color: var(--color-accent-hover);
  color: #1a0f00;
}

.action-button--primary:disabled {
  background: var(--color-surface);
  color: var(--color-text-muted);
  border-color: var(--color-border);
  opacity: 0.7;
}

/* ==================== INVENTORY ==================== */

.inventory-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
  gap: 8px;
  margin-bottom: 14px;
}

.inventory-cell {
  aspect-ratio: 1;
  padding: 6px;
  background: rgba(13, 10, 26, 0.5);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  color: var(--color-text);
  font-family: var(--font-main);
  font-size: 0.72rem;
  cursor: pointer;
  text-align: center;
  overflow: hidden;
  word-break: break-word;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  transition: border-color 0.15s, background 0.15s, transform 0.1s;
}

.inventory-cell:hover:not(.inventory-cell--empty) {
  border-color: var(--color-accent);
  background: rgba(212, 162, 78, 0.08);
  transform: translateY(-1px);
}

.inventory-cell--empty {
  background: rgba(13, 10, 26, 0.2);
  cursor: default;
}

.inventory-cell--weapon { border-color: #a05a5a; }
.inventory-cell--armor { border-color: #5a7aa0; }
.inventory-cell--accessory { border-color: #a08a5a; }
.inventory-cell--consumable { border-color: #5aa07a; }
.inventory-cell--buff { border-color: rgba(106, 184, 122, 0.7); }
.inventory-cell--enhanced { border-color: #c8a24e; box-shadow: inset 0 0 8px rgba(212, 162, 78, 0.15); }

.inventory-cell__name { font-size: 0.7rem; line-height: 1.2; }
.inventory-cell__qty { font-size: 0.64rem; color: var(--color-text-muted); }
.inventory-cell__dur { font-size: 0.62rem; color: var(--color-text-muted); }

.inventory-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }

/* ==================== EQUIPMENT ==================== */

.equipment-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 6px;
  margin-bottom: 16px;
}

.equipment-row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10px 12px;
  background: rgba(13, 10, 26, 0.5);
  border: 1px solid var(--color-border);
  border-radius: 5px;
  color: var(--color-text);
  font-family: var(--font-main);
  font-size: 0.85rem;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}

.equipment-row--filled:hover {
  border-color: var(--color-accent);
  background: rgba(212, 162, 78, 0.08);
}

.equipment-row--empty { cursor: default; opacity: 0.6; }
.equipment-row--enhanced .equipment-row__value { color: var(--color-accent); }
.equipment-row__label {
  color: var(--color-text-muted);
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}
.equipment-row__value { font-weight: 500; }

/* ==================== ENHANCEMENT ==================== */

.enh-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }

.enh-item {
  text-align: left;
  padding: 10px 12px;
  background: rgba(13, 10, 26, 0.5);
  border: 1px solid var(--color-border);
  border-radius: 5px;
  color: var(--color-text);
  font-family: var(--font-main);
  font-size: 0.85rem;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}

.enh-item:hover { border-color: var(--color-accent); background: rgba(212, 162, 78, 0.08); }
.enh-item--selected {
  border-color: var(--color-accent);
  background: rgba(212, 162, 78, 0.15);
  color: var(--color-accent);
}

.enh-preview {
  margin-top: 14px;
  padding: 16px;
  background: rgba(13, 10, 26, 0.6);
  border: 1px solid var(--color-border-strong);
  border-radius: 8px;
}

.enh-preview h3 {
  margin: 0 0 12px;
  font-family: var(--font-display);
  font-size: 1.05rem;
  color: var(--color-accent);
  text-transform: none;
  letter-spacing: 0;
}

.enh-warning {
  margin-top: 10px;
  font-size: 0.82rem;
  color: var(--color-danger);
}

.enh-actions { display: flex; gap: 8px; margin-top: 14px; flex-wrap: wrap; }

.enh-history {
  display: flex; flex-direction: column; gap: 3px;
  max-height: 220px; overflow-y: auto;
  padding: 8px; border: 1px solid var(--color-border);
  border-radius: 5px; background: rgba(13, 10, 26, 0.5);
  font-size: 0.78rem;
}

.enh-history__entry {
  padding: 4px 8px;
  border-left: 3px solid var(--color-text-muted);
  border-radius: 3px;
}

.enh-history__entry--ok { border-left-color: var(--color-success); color: #a8e0b8; }
.enh-history__entry--fail { border-left-color: var(--color-danger); color: #e0a8b0; }

/* ==================== COMBAT PANEL ==================== */

.combat-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0 16px; }

.bar { margin-bottom: 12px; }

.bar__head {
  display: flex; justify-content: space-between;
  font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 5px;
}

.bar__value { color: var(--color-text); font-weight: 600; }

.bar__track {
  width: 100%; height: 12px; border-radius: 6px;
  background: rgba(13, 10, 26, 0.8); overflow: hidden;
  border: 1px solid var(--color-border);
}

.bar__fill { height: 100%; transition: width 0.35s ease-out; }

.bar--hp .bar__fill { background: linear-gradient(90deg, #3a8a4a, #6ab87a); }
.bar--resource .bar__fill { background: linear-gradient(90deg, #3a5a8a, #6a8ac8); }
.bar--enemy .bar__fill { background: linear-gradient(90deg, #8a3a4a, #c94a5a); }

.combat-log {
  display: flex; flex-direction: column; gap: 3px;
  max-height: 280px; overflow-y: auto;
  padding: 10px; border: 1px solid var(--color-border);
  border-radius: 5px; background: rgba(13, 10, 26, 0.5);
  font-size: 0.78rem; font-family: "Consolas", monospace;
}

.combat-log__entry { padding: 3px 6px; border-radius: 3px; }
.combat-log__entry--player-basic { color: #b8d8ff; }
.combat-log__entry--player-skill { color: #ffd88a; }
.combat-log__entry--monster-basic { color: #ffb8c8; }
.combat-log__entry--victory { color: var(--color-success); font-weight: 700; }
.combat-log__entry--defeat { color: var(--color-danger); font-weight: 700; }

.zone-list { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }

/* ==================== LIFESKILL ==================== */

.prof-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 8px;
  margin-bottom: 16px;
}

.prof-card {
  padding: 10px 12px;
  background: rgba(13, 10, 26, 0.5);
  border: 1px solid var(--color-border);
  border-radius: 5px;
}

.prof-card__name {
  font-family: var(--font-display);
  font-size: 0.95rem;
  color: var(--color-accent);
}

.prof-card__info { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 3px; }

.lifeskill-subhead {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 1.5px;
  margin: 16px 0 8px;
}

.node-card, .recipe-card {
  background: rgba(13, 10, 26, 0.6);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 14px;
  margin-bottom: 10px;
}

.node-card h3, .recipe-card h4 {
  font-family: var(--font-display);
  font-size: 0.95rem;
  color: var(--color-accent);
  margin: 0 0 6px;
  text-transform: none;
  letter-spacing: 0;
}

.node-card p, .recipe-card p { font-size: 0.82rem; margin-bottom: 6px; }

.node-warning {
  color: var(--color-danger) !important;
  font-size: 0.78rem !important;
  margin-top: 8px !important;
}

.recipe-io { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0; }

.recipe-io__item {
  font-size: 0.75rem;
  padding: 3px 8px;
  background: rgba(13, 10, 26, 0.7);
  border: 1px solid var(--color-border);
  border-radius: 4px;
}

.recipe-io__item--missing {
  color: var(--color-danger);
  border-color: var(--color-danger);
}

.recipe-io--output .recipe-io__item {
  color: var(--color-success);
  border-color: rgba(106, 184, 122, 0.5);
}

.recipe-batches { display: flex; align-items: center; gap: 8px; margin: 10px 0; }
.recipe-batches__num {
  min-width: 32px; text-align: center; font-weight: 600; color: var(--color-accent);
}

.activity-box {
  background: rgba(13, 10, 26, 0.6);
  border: 1px solid var(--color-border-strong);
  border-radius: 8px;
  padding: 16px;
}

.activity-box h3 { margin: 0 0 8px; color: var(--color-accent); }
.activity-box__name { font-size: 1rem; margin-bottom: 12px; }

/* ==================== AGRICULTURE ==================== */

.farm-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 10px;
  margin-bottom: 16px;
}

.farm-plot {
  padding: 12px;
  background: rgba(13, 10, 26, 0.6);
  border: 1px solid var(--color-border);
  border-radius: 6px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.farm-plot--empty { opacity: 0.7; }
.farm-plot__title {
  font-size: 0.72rem; color: var(--color-text-muted);
  text-transform: uppercase; letter-spacing: 1px;
}
.farm-plot__crop {
  font-family: var(--font-display);
  font-size: 0.92rem;
  color: var(--color-accent);
}

.seed-list { display: flex; flex-direction: column; gap: 6px; }

.seed-card {
  display: flex; justify-content: space-between; align-items: center;
  padding: 8px 12px;
  background: rgba(13, 10, 26, 0.5);
  border: 1px solid var(--color-border);
  border-radius: 5px;
}

.seed-card__name { font-size: 0.85rem; }
.seed-card--shop { justify-content: space-between; }
.seed-card__left { display: flex; flex-direction: column; gap: 2px; }
.seed-card__buttons { display: flex; gap: 4px; }
.seed-card__buttons .action-button { min-width: 42px; padding: 4px 8px; }

/* ==================== NPC SHOP ==================== */

.npc-shop-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }

.npc-shop-card {
  display: flex; justify-content: space-between; align-items: center;
  padding: 10px 14px;
  background: rgba(13, 10, 26, 0.5);
  border: 1px solid var(--color-border);
  border-radius: 5px;
}

.npc-shop-card__left { display: flex; flex-direction: column; gap: 3px; }
.npc-shop-card__name { font-size: 0.9rem; color: var(--color-text); }
.npc-shop-card__buttons { display: flex; gap: 4px; }
.npc-shop-card__buttons .action-button { min-width: 42px; padding: 4px 8px; }

/* ==================== METRICS ==================== */

.transaction-log {
  display: flex; flex-direction: column; gap: 3px;
  max-height: 320px; overflow-y: auto;
  padding: 8px; border: 1px solid var(--color-border);
  border-radius: 5px; background: rgba(13, 10, 26, 0.5);
  font-size: 0.78rem; font-family: "Consolas", monospace;
}

.transaction-log__entry {
  padding: 4px 8px;
  border-left: 3px solid var(--color-text-muted);
}
.transaction-log__entry--positive { border-left-color: #6ab87a; color: #a8e0b8; }
.transaction-log__entry--negative { border-left-color: #c94a5a; color: #e0a8b0; }

/* ==================== IDLE ==================== */

.idle-kind-row { display: flex; gap: 8px; margin-bottom: 14px; flex-wrap: wrap; }
.idle-target-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }

.idle-target {
  text-align: left;
  padding: 10px 14px;
  background: rgba(13, 10, 26, 0.5);
  border: 1px solid var(--color-border);
  border-radius: 5px;
  color: var(--color-text);
  font-family: var(--font-main);
  font-size: 0.85rem;
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s;
}

.idle-target:hover { border-color: var(--color-accent); background: rgba(212, 162, 78, 0.08); }
.idle-target--selected {
  border-color: var(--color-accent);
  background: rgba(212, 162, 78, 0.15);
  color: var(--color-accent);
}

.idle-report {
  margin-top: 18px;
  padding: 16px;
  background: rgba(212, 162, 78, 0.06);
  border: 1px solid var(--color-accent);
  border-radius: 8px;
}

.idle-report h3 {
  margin: 0 0 12px;
  color: var(--color-accent);
  font-family: var(--font-display);
  font-size: 1.05rem;
  text-transform: none;
  letter-spacing: 0;
}

.idle-report__sub {
  font-size: 0.78rem;
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  margin: 14px 0 8px;
}

/* ==================== QUESTS ==================== */

.quest-filters { display: flex; gap: 8px; margin-bottom: 12px; flex-wrap: wrap; }

.quest-card {
  background: rgba(13, 10, 26, 0.6);
  border: 1px solid var(--color-border);
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 12px;
}

.quest-card--available { border-left: 3px solid #7ad4ff; }
.quest-card--active { border-left: 3px solid var(--color-accent); }
.quest-card--completed { border-left: 3px solid #6ab87a; opacity: 0.85; }

.quest-card__header {
  display: flex; justify-content: space-between; align-items: baseline;
  gap: 10px; margin-bottom: 8px;
}

.quest-card__header h3 {
  font-family: var(--font-display);
  font-size: 1rem;
  color: var(--color-accent);
  margin: 0;
}

.quest-card__category {
  font-size: 0.62rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--color-text-muted);
  padding: 2px 8px;
  border: 1px solid var(--color-border);
  border-radius: 3px;
}

.quest-card__desc {
  font-size: 0.82rem;
  color: var(--color-text-muted);
  margin-bottom: 12px;
  line-height: 1.5;
}

.quest-objectives { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }

.quest-objective {
  display: flex; align-items: center; gap: 8px;
  font-size: 0.82rem;
}

.quest-objective__marker {
  font-weight: 700;
  min-width: 20px;
  text-align: center;
  font-size: 0.72rem;
}

.quest-objective--pending .quest-objective__marker { color: var(--color-text-muted); }
.quest-objective--done .quest-objective__marker { color: #6ab87a; }
.quest-objective--done .quest-objective__text { color: #a8e0b8; text-decoration: line-through; }
.quest-objective--pending .quest-objective__text { color: var(--color-text); }

.quest-objective__count {
  margin-left: auto;
  font-size: 0.75rem;
  color: var(--color-text-muted);
  font-variant-numeric: tabular-nums;
}

.quest-rewards {
  display: flex; flex-wrap: wrap; gap: 8px;
  align-items: center;
  padding-top: 10px;
  border-top: 1px dashed rgba(154, 140, 184, 0.2);
  font-size: 0.78rem;
}

.quest-rewards__label {
  color: var(--color-text-muted);
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: 0.68rem;
}

.quest-reward__silver { color: var(--color-accent); font-weight: 600; }
.quest-reward__xp { color: #7ad4ff; font-weight: 600; }
.quest-reward__item { color: #a8e0b8; }

.quest-actions { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; }

.quest-claim { animation: quest-pulse 1.6s ease-in-out infinite; }

@keyframes quest-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(212, 162, 78, 0); }
  50% { box-shadow: 0 0 12px 2px rgba(212, 162, 78, 0.45); }
}

.quest-done-badge { font-size: 0.78rem; color: #6ab87a; font-style: italic; }

/* ==================== SAVE CONTROLS ==================== */

.save-controls-host {
  position: fixed;
  bottom: 16px;
  left: 16px;
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  background: rgba(13, 10, 26, 0.92);
  padding: 8px;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  backdrop-filter: blur(6px);
  z-index: 30;
}

.persistence-controls { display: flex; gap: 6px; flex-wrap: wrap; }

/* ==================== TUTORIAL OVERLAY ==================== */

.tutorial-overlay-host {
  position: fixed;
  top: calc(var(--header-height) + var(--tabs-height) + 12px);
  right: 16px;
  z-index: 100;
  pointer-events: none;
  max-width: 320px;
}

.tutorial-overlay {
  background: linear-gradient(135deg, rgba(20, 14, 40, 0.96) 0%, rgba(13, 10, 26, 0.96) 100%);
  border: 1px solid var(--color-accent);
  border-radius: 8px;
  padding: 14px 18px;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.55), 0 0 24px rgba(212, 162, 78, 0.18);
  animation: tutorial-fade-in 0.4s ease-out;
}

.tutorial-overlay--done { display: none; }

@keyframes tutorial-fade-in {
  from { opacity: 0; transform: translateY(-8px); }
  to { opacity: 1; transform: translateY(0); }
}

.tutorial-overlay__label {
  font-size: 0.65rem;
  color: var(--color-accent);
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 4px;
  opacity: 0.8;
}

.tutorial-overlay__title {
  font-family: var(--font-display);
  font-size: 1.05rem;
  color: var(--color-accent);
  margin-bottom: 4px;
}

.tutorial-overlay__desc {
  font-size: 0.82rem;
  color: var(--color-text);
  line-height: 1.4;
  margin-bottom: 6px;
}

.tutorial-overlay__progress {
  font-size: 0.75rem;
  color: #7ad4ff;
  font-weight: 600;
  margin-bottom: 4px;
}

.tutorial-overlay__reward {
  font-size: 0.72rem;
  color: var(--color-text-muted);
  font-style: italic;
}

/* ==================== TOASTS ==================== */

#toast-container {
  position: fixed;
  bottom: 90px;
  right: 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  z-index: 1000;
  pointer-events: none;
}

.toast {
  padding: 12px 18px;
  background: var(--color-surface-alt);
  border-left: 3px solid var(--color-accent);
  border-radius: 5px;
  color: var(--color-text);
  font-size: 0.88rem;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.55);
  opacity: 0;
  transform: translateX(20px);
  transition: opacity 0.2s, transform 0.2s;
  max-width: 340px;
}

.toast--visible { opacity: 1; transform: translateX(0); }
.toast--warn { border-left-color: var(--color-warn); }
.toast--error { border-left-color: var(--color-danger); }

/* ==================== RESPONSIVE ==================== */

@media (max-width: 900px) {
  .activity-banner__right { min-width: 240px; }
  .activity-banner__bar-row { min-width: 140px; }
}

@media (max-width: 768px) {
  :root {
    --banner-height: 100px;
    --header-height: 52px;
  }

  .header-brand h1 { font-size: 0.95rem; }
  .resource-bar { gap: 12px; }
  .resource-bar__value { font-size: 0.8rem; }

  .activity-banner {
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    padding: 10px 16px;
  }

  .activity-banner__icon { width: 40px; height: 40px; font-size: 1.3rem; }
  .activity-banner__title { font-size: 0.9rem; }
  .activity-banner__sub { font-size: 0.72rem; }
  .activity-banner__right { min-width: 0; justify-content: flex-start; flex-wrap: wrap; }
  .activity-banner__bar-row { min-width: 0; width: 100%; }

  .tutorial-overlay-host {
    top: auto;
    bottom: 90px;
    left: 12px;
    right: 12px;
    max-width: none;
  }

  #side-panel-content { padding: 16px 14px 120px; }
  .info-grid { grid-template-columns: 1fr; }
  .inventory-grid { grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); }
}

@media (max-width: 480px) {
  :root { --banner-height: 110px; }

  .tab-button { padding: 0 12px; font-size: 0.75rem; }
  .save-controls-host { bottom: 8px; left: 8px; padding: 6px; }
  #toast-container { bottom: 80px; right: 12px; left: 12px; }
}
/* ==================== ICON SYSTEM ==================== */

.icon-label { display: inline-flex; align-items: center; gap: 6px; }

svg {
  display: inline-block;
  vertical-align: middle;
  flex-shrink: 0;
}

/* Icones dentro de resource-bar */
.resource-bar__icon {
  opacity: 0.75;
  margin-right: 4px;
  color: var(--color-accent);
}

.resource-bar__label {
  display: inline-flex;
  align-items: center;
  gap: 2px;
}

/* Icones dentro de buttons */
.action-button svg {
  margin-right: 6px;
  vertical-align: -2px;
}

.action-button--danger svg { color: var(--color-danger); }

/* Banner: icones grandes */
.activity-banner__icon svg {
  width: 28px;
  height: 28px;
}

.activity-banner__bar-label svg {
  opacity: 0.7;
  margin-right: 4px;
}

/* Toast com icone */
.toast {
  display: flex;
  align-items: center;
  gap: 10px;
}

.toast__icon { flex-shrink: 0; color: var(--color-accent); }
.toast--warn .toast__icon { color: var(--color-warn); }
.toast--error .toast__icon { color: var(--color-danger); }

.toast__text { flex: 1; }

/* ==================== TIPOGRAFIA ==================== */

h1, h2, h3, h4, .tab-button, .zone-card h3, .prof-card__name {
  font-family: var(--font-display);
  letter-spacing: 0.4px;
}

.panel-content h2 {
  font-size: 1.5rem;
  font-weight: 700;
}

.activity-banner__title {
  font-family: var(--font-display);
  letter-spacing: 0.3px;
}

/* Numeros tabulares (evita "salto" de largura) */
.resource-bar__value,
.activity-banner__bar-text,
.info-row__value,
.quest-objective__count,
.transaction-log {
  font-variant-numeric: tabular-nums;
}

/* ==================== MICRO-ANIMACOES ==================== */

/* Painel entra com fade + slide */
@keyframes panel-enter {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.panel-content {
  animation: panel-enter 0.25s ease-out;
}

/* Cards elevam no hover */
.zone-card, .node-card, .recipe-card, .quest-card, .prof-card, .farm-plot, .npc-shop-card, .enh-item, .idle-target, .seed-card {
  transition: border-color 0.15s, background 0.15s, transform 0.15s, box-shadow 0.15s;
}

.zone-card:hover, .node-card:hover, .recipe-card:hover, .quest-card:hover {
  border-color: var(--color-border-strong);
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
  transform: translateY(-1px);
}

/* Botoes pulsantes (quest-claim) */
@keyframes subtle-pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 rgba(212, 162, 78, 0);
    transform: scale(1);
  }
  50% {
    box-shadow: 0 0 16px 3px rgba(212, 162, 78, 0.5);
    transform: scale(1.02);
  }
}

.quest-claim,
.action-button--primary:not(:disabled) {
  animation: subtle-pulse 2.5s ease-in-out infinite;
}

.quest-claim:hover,
.action-button--primary:not(:disabled):hover {
  animation: none;
  transform: scale(1.03);
}

/* Barra de progresso com shimmer */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

.activity-banner__bar-fill,
.bar__fill {
  background-size: 200% 100% !important;
  position: relative;
  overflow: hidden;
}

.activity-banner__bar-fill::after,
.bar__fill::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.15) 50%,
    transparent 100%
  );
  animation: shimmer 3s linear infinite;
}

/* Tabs com hover mais elegante */
.tab-button {
  position: relative;
  transition: color 0.2s, background 0.2s;
}

.tab-button::before {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 0;
  height: 2px;
  background: var(--color-accent);
  transition: width 0.2s ease-out, left 0.2s ease-out;
}

.tab-button:hover::before {
  left: 20%;
  width: 60%;
}

.tab-button--active::before {
  left: 0;
  width: 100%;
}

/* Botao elevacao */
.action-button {
  position: relative;
  transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.1s, box-shadow 0.15s;
}

.action-button:active:not(:disabled) {
  transform: translateY(1px) scale(0.98);
}

.action-button:hover:not(:disabled) {
  box-shadow: 0 2px 10px rgba(212, 162, 78, 0.15);
}

/* Cards entram com fade em cascata (opcional, so para paineis grandes) */
@keyframes card-in {
  from { opacity: 0; transform: translateY(4px); }
  to { opacity: 1; transform: translateY(0); }
}

.quest-card, .node-card, .recipe-card, .farm-plot {
  animation: card-in 0.3s ease-out backwards;
}

/* Save controls com fade sempre que aparecem */
@keyframes controls-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.save-controls-host {
  animation: controls-in 0.4s ease-out 0.3s backwards;
}

/* Tutorial overlay com glow subtil */
.tutorial-overlay {
  animation: tutorial-fade-in 0.4s ease-out, tutorial-glow 3s ease-in-out infinite 0.4s;
}

@keyframes tutorial-glow {
  0%, 100% { box-shadow: 0 6px 24px rgba(0, 0, 0, 0.55), 0 0 24px rgba(212, 162, 78, 0.18); }
  50% { box-shadow: 0 6px 24px rgba(0, 0, 0, 0.55), 0 0 32px rgba(212, 162, 78, 0.35); }
}

/* Foco acessivel */
button:focus-visible,
.tab-button:focus-visible,
.action-button:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

/* Scrollbar mais elegante (padrao em todo o site) */
* {
  scrollbar-width: thin;
  scrollbar-color: var(--color-border-strong) transparent;
}

*::-webkit-scrollbar { width: 8px; height: 8px; }
*::-webkit-scrollbar-track { background: transparent; }
*::-webkit-scrollbar-thumb {
  background: var(--color-border-strong);
  border-radius: 4px;
}
*::-webkit-scrollbar-thumb:hover { background: var(--color-accent); }

/* Reduzir animacoes se o utilizador preferir */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ==================== ITEM CELLS ==================== */

.item-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
  gap: 8px;
  margin-bottom: 16px;
}

.item-cell {
  position: relative;
  aspect-ratio: 1;
  padding: 6px 4px 4px;
  background: linear-gradient(180deg, rgba(26, 20, 48, 0.8) 0%, rgba(13, 10, 26, 0.95) 100%);
  border: 1px solid var(--rarity-border, var(--color-border));
  border-radius: 6px;
  color: var(--color-text);
  font-family: var(--font-main);
  font-size: 0.7rem;
  cursor: pointer;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 2px;
  overflow: hidden;
  transition: border-color 0.15s, transform 0.12s, box-shadow 0.15s;
  box-shadow: inset 0 0 20px var(--rarity-glow, transparent);
}

.item-cell:hover:not(:disabled):not(.item-cell--empty) {
  border-color: var(--rarity-border);
  transform: translateY(-2px);
  box-shadow:
    inset 0 0 20px var(--rarity-glow, transparent),
    0 4px 16px rgba(0, 0, 0, 0.4),
    0 0 20px var(--rarity-glow, transparent);
}

.item-cell:active:not(:disabled):not(.item-cell--empty) {
  transform: translateY(0) scale(0.97);
}

.item-cell--empty {
  background: rgba(13, 10, 26, 0.25);
  border: 1px dashed rgba(154, 140, 184, 0.15);
  cursor: default;
  box-shadow: none;
}

.item-cell--empty:hover {
  border-color: rgba(154, 140, 184, 0.2);
  transform: none;
  box-shadow: none;
}

.item-cell--disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.item-cell__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  flex: 1;
  margin-top: 2px;
  filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.6));
}

.item-cell__icon svg {
  width: 32px;
  height: 32px;
}

.item-cell__name {
  font-size: 0.65rem;
  line-height: 1.1;
  text-align: center;
  color: var(--color-text);
  width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 2px;
}

.item-cell__qty {
  position: absolute;
  top: 3px;
  right: 4px;
  font-size: 0.62rem;
  font-weight: 700;
  color: #fff;
  background: rgba(13, 10, 26, 0.9);
  border: 1px solid var(--color-border-strong);
  padding: 0 5px;
  border-radius: 8px;
  line-height: 1.4;
  font-variant-numeric: tabular-nums;
}

.item-cell__enh {
  position: absolute;
  top: 3px;
  left: 4px;
  font-size: 0.62rem;
  font-weight: 700;
  color: #1a0f00;
  background: linear-gradient(180deg, #e8c87a 0%, #c8a24e 100%);
  padding: 0 5px;
  border-radius: 8px;
  line-height: 1.4;
  box-shadow: 0 0 8px rgba(212, 162, 78, 0.6);
}

.item-cell__dur {
  font-size: 0.58rem;
  color: var(--color-text-muted);
  line-height: 1;
  margin-bottom: 2px;
  font-variant-numeric: tabular-nums;
}

.item-cell--low-dur .item-cell__dur {
  color: var(--color-danger);
  font-weight: 600;
}

.item-cell--equippable::after,
.item-cell--consumable::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 2px;
  border-radius: 1px 1px 0 0;
}

.item-cell--equippable::after { background: rgba(90, 159, 212, 0.7); }
.item-cell--consumable::after { background: rgba(106, 184, 122, 0.7); }

/* Inventory responsive */
@media (max-width: 768px) {
  .item-grid { grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 6px; }
  .item-cell__icon svg { width: 26px; height: 26px; }
  .item-cell__name { font-size: 0.6rem; }
}

@media (max-width: 480px) {
  .item-grid { grid-template-columns: repeat(auto-fill, minmax(60px, 1fr)); }
  .item-cell__icon svg { width: 22px; height: 22px; }
}

/* ==================== PANEL HEADER ==================== */

.panel-header {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 4px 0 18px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--color-border);
  position: relative;
}

.panel-header__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 10px;
  background: linear-gradient(135deg, rgba(212, 162, 78, 0.18) 0%, rgba(212, 162, 78, 0.06) 100%);
  border: 1px solid rgba(212, 162, 78, 0.35);
  color: var(--color-accent);
  flex-shrink: 0;
  box-shadow: inset 0 0 20px rgba(212, 162, 78, 0.1);
}

.panel-header__text { flex: 1; min-width: 0; }

.panel-header__title {
  font-family: var(--font-display);
  font-size: 1.55rem;
  font-weight: 700;
  color: var(--color-accent);
  letter-spacing: 0.6px;
  line-height: 1.2;
  margin: 0;
  text-shadow: 0 0 18px rgba(212, 162, 78, 0.15);
}

.panel-header__sub {
  font-size: 0.85rem;
  color: var(--color-text-muted);
  font-style: italic;
  margin: 2px 0 0;
}

.panel-header__deco {
  position: absolute;
  bottom: -1px;
  right: 0;
  width: 60px;
  height: 2px;
  background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
  opacity: 0.7;
}

/* ==================== SECTION TITLE ==================== */

.section-title {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 22px 0 12px;
  color: var(--color-text-muted);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-weight: 600;
}

.section-title::before,
.section-title::after {
  content: "";
  height: 1px;
  flex: 1;
  background: linear-gradient(90deg, transparent, var(--color-border-strong), transparent);
}

.section-title span {
  flex-shrink: 0;
  color: var(--color-accent);
  opacity: 0.85;
}

/* ==================== BUTTONS ==================== */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 8px 16px;
  background: linear-gradient(180deg, rgba(34, 26, 58, 0.9) 0%, rgba(20, 14, 40, 0.9) 100%);
  color: var(--color-text);
  border: 1px solid var(--color-border-strong);
  border-radius: 6px;
  font-family: var(--font-main);
  font-size: 0.85rem;
  font-weight: 500;
  letter-spacing: 0.3px;
  cursor: pointer;
  transition: all 0.15s ease-out;
  position: relative;
  overflow: hidden;
  white-space: nowrap;
}

.btn::before {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04) 0%, transparent 100%);
  pointer-events: none;
}

.btn:hover:not(:disabled) {
  border-color: var(--color-accent);
  color: var(--color-accent);
  box-shadow: 0 4px 16px rgba(212, 162, 78, 0.15), inset 0 0 20px rgba(212, 162, 78, 0.06);
  transform: translateY(-1px);
}

.btn:active:not(:disabled) {
  transform: translateY(0) scale(0.98);
}

.btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  filter: grayscale(0.5);
}

.btn__icon {
  flex-shrink: 0;
  opacity: 0.85;
}

.btn--primary {
  background: linear-gradient(180deg, #e8b86a 0%, #c8a24e 100%);
  color: #1a0f00;
  border-color: #8a6a2a;
  font-weight: 700;
}

.btn--primary::before {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.25) 0%, transparent 100%);
}

.btn--primary .btn__icon { opacity: 0.9; }

.btn--primary:hover:not(:disabled) {
  color: #1a0f00;
  border-color: #a87a2a;
  box-shadow: 0 4px 20px rgba(232, 184, 106, 0.4);
  background: linear-gradient(180deg, #f0c878 0%, #d4ae58 100%);
}

.btn--primary:disabled {
  background: linear-gradient(180deg, #4a3a2a 0%, #2a2018 100%);
  color: #6a5a3a;
  border-color: #3a2a1a;
}

.btn--danger {
  border-color: rgba(201, 74, 90, 0.6);
  color: #e8a8b0;
}

.btn--danger:hover:not(:disabled) {
  border-color: var(--color-danger);
  color: var(--color-danger);
  background: linear-gradient(180deg, rgba(201, 74, 90, 0.15) 0%, rgba(201, 74, 90, 0.05) 100%);
  box-shadow: 0 4px 16px rgba(201, 74, 90, 0.2);
}

.btn--icon {
  padding: 6px;
  min-width: 30px;
  height: 30px;
}

.btn--icon .btn__label { display: none; }

.action-row {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin: 12px 0;
}

/* ==================== EQUIP GRID ==================== */

.equip-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 10px;
  margin-bottom: 16px;
}

.equip-slot {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.equip-slot__label {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--color-text-muted);
  font-weight: 600;
}

.equip-slot .item-cell {
  aspect-ratio: 1.15;
  width: 100%;
}

.equip-empty {
  aspect-ratio: 1.15;
  border: 1px dashed rgba(154, 140, 184, 0.2);
  border-radius: 6px;
  background: rgba(13, 10, 26, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.equip-empty__icon {
  color: rgba(154, 140, 184, 0.25);
  opacity: 0.5;
}

/* ==================== SHOP GRID ==================== */

.shop-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

.shop-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.shop-item .item-cell {
  aspect-ratio: 1;
  width: 100%;
}

.shop-item__price {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--color-accent);
  padding: 3px 8px;
  border-radius: 4px;
  background: rgba(212, 162, 78, 0.1);
  border: 1px solid rgba(212, 162, 78, 0.3);
  font-variant-numeric: tabular-nums;
}

.shop-item__price--sell {
  color: #7ad4ff;
  background: rgba(122, 212, 255, 0.08);
  border-color: rgba(122, 212, 255, 0.25);
}

/* ==================== RECIPE HEADER ==================== */

.recipe-card__header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 8px;
}

.recipe-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 8px;
  background: linear-gradient(135deg, rgba(212, 162, 78, 0.15) 0%, rgba(212, 162, 78, 0.05) 100%);
  border: 1px solid rgba(212, 162, 78, 0.3);
  color: var(--color-accent);
  flex-shrink: 0;
}

.recipe-card__header h4 {
  margin: 0;
  font-family: var(--font-display);
  font-size: 0.98rem;
  color: var(--color-accent);
}

.recipe-card__header .muted { margin: 2px 0 0; font-size: 0.78rem; }

/* ==================== PROFILE CARD HOVER ==================== */

.prof-card {
  background: linear-gradient(135deg, rgba(26, 20, 48, 0.6) 0%, rgba(13, 10, 26, 0.6) 100%);
  position: relative;
  overflow: hidden;
}

.prof-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(180deg, var(--color-accent), transparent);
  opacity: 0.6;
}

.prof-card:hover::before { opacity: 1; }

/* ==================== RESPONSIVE ==================== */

@media (max-width: 768px) {
  .panel-header { gap: 12px; padding-bottom: 14px; }
  .panel-header__icon { width: 44px; height: 44px; }
  .panel-header__icon svg { width: 22px; height: 22px; }
  .panel-header__title { font-size: 1.25rem; }
  .panel-header__sub { font-size: 0.78rem; }

  .equip-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 8px; }
  .shop-grid { grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 10px; }

  .btn { padding: 7px 12px; font-size: 0.8rem; }
}

/* ==================== POWER BREAKDOWN (Fase 16) ==================== */

.power-breakdown {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

.power-block {
  padding: 12px 14px;
  background: linear-gradient(135deg, rgba(26, 20, 48, 0.6) 0%, rgba(13, 10, 26, 0.7) 100%);
  border: 1px solid var(--color-border);
  border-left: 3px solid var(--color-accent);
  border-radius: 6px;
  position: relative;
}

.power-block__title {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 1.5px;
  color: var(--color-text-muted);
  margin-bottom: 4px;
  font-weight: 600;
}

.power-block__total {
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--color-accent);
  line-height: 1.1;
  margin-bottom: 8px;
  text-shadow: 0 0 12px rgba(212, 162, 78, 0.2);
}

.power-block__lines {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-top: 8px;
  border-top: 1px dashed rgba(154, 140, 184, 0.2);
}

.power-block__sub {
  display: flex;
  justify-content: space-between;
  font-size: 0.76rem;
  color: var(--color-text-muted);
}

.power-block__sub span:last-child {
  color: var(--color-text);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}

/* ==================== ESSENCES (Fase 17) ==================== */

.equip-essence-row {
  display: flex;
  gap: 4px;
  justify-content: center;
  margin-top: 4px;
}

.essence-chip {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 1px solid var(--color-border-strong);
  background: rgba(13, 10, 26, 0.7);
  color: var(--color-text-muted);
  font-family: var(--font-main);
  font-size: 0.65rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s ease-out;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.essence-chip--empty {
  border-style: dashed;
  opacity: 0.5;
  cursor: default;
}

.essence-chip--filled {
  border-color: #c8a8ff;
  background: linear-gradient(135deg, rgba(120, 80, 180, 0.9) 0%, rgba(60, 30, 90, 0.9) 100%);
  color: #ffffff;
  box-shadow: 0 0 8px rgba(168, 98, 204, 0.4);
}

.essence-chip--filled:hover {
  border-color: var(--color-danger);
  background: linear-gradient(135deg, rgba(200, 74, 90, 0.9) 0%, rgba(90, 30, 40, 0.9) 100%);
  box-shadow: 0 0 12px rgba(201, 74, 90, 0.5);
}

.essence-apply-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
}

.essence-apply-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 8px 12px;
  background: linear-gradient(135deg, rgba(120, 80, 180, 0.08) 0%, rgba(60, 30, 90, 0.08) 100%);
  border: 1px solid rgba(168, 98, 204, 0.35);
  border-radius: 5px;
}

.essence-apply-info {
  font-size: 0.82rem;
  color: var(--color-text);
}

.item-cell__essences {
  position: absolute;
  bottom: 3px;
  right: 4px;
  font-size: 0.6rem;
  font-weight: 700;
  color: #e0d0ff;
  background: rgba(60, 30, 90, 0.9);
  border: 1px solid rgba(168, 98, 204, 0.7);
  padding: 0 5px;
  border-radius: 8px;
  line-height: 1.4;
  letter-spacing: 0.5px;
  box-shadow: 0 0 8px rgba(168, 98, 204, 0.4);
}

.item-cell--essenced {
  box-shadow:
    inset 0 0 20px var(--rarity-glow, transparent),
    0 0 12px rgba(168, 98, 204, 0.2);
}

/* ============================================================
   CHARACTER SHEET (Bloco 9)
   Nova UI unificada: slots + stats + inventario com filtros.
   Nao substitui nada - classes exclusivas com prefixo .sheet__
   ============================================================ */

.sheet {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 12px;
  background: linear-gradient(180deg, rgba(20,18,30,0.95), rgba(15,14,24,0.95));
  border: 1px solid rgba(180,150,60,0.25);
  border-radius: 10px;
  color: #e6e1d3;
  font-family: inherit;
}

/* ---------- Header ---------- */
.sheet__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  border-bottom: 1px solid rgba(180,150,60,0.35);
  background: linear-gradient(180deg, rgba(30,26,45,0.7), rgba(20,18,30,0.4));
  border-radius: 8px 8px 0 0;
}
.sheet__title {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #e8c977;
  text-shadow: 0 0 8px rgba(232,201,119,0.35);
}
.sheet__wallet {
  display: flex;
  gap: 18px;
  font-size: 13px;
}
.sheet__wallet-item b {
  color: #e8c977;
  font-weight: 600;
  margin-right: 4px;
}

/* ---------- Body (3 colunas) ---------- */
.sheet__body {
  display: grid;
  grid-template-columns: 1fr 1fr 1.6fr;
  gap: 12px;
  min-height: 520px;
}

.sheet__col {
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 12px;
  background: rgba(25,22,38,0.6);
  border: 1px solid rgba(180,150,60,0.18);
  border-radius: 8px;
}
.sheet__col-title {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #e8c977;
  margin: 0 0 6px 0;
  text-align: center;
  text-transform: uppercase;
}

/* ---------- Slots ---------- */
.sheet__slot-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}
.sheet__slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.sheet__slot-empty {
  width: 64px;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed rgba(180,150,60,0.35);
  border-radius: 8px;
  color: rgba(180,150,60,0.35);
  background: rgba(15,14,24,0.5);
  transition: border-color 0.15s, color 0.15s;
}
.sheet__slot-empty:hover {
  border-color: rgba(232,201,119,0.7);
  color: rgba(232,201,119,0.7);
}
.sheet__slot-label {
  font-size: 10px;
  letter-spacing: 1px;
  color: rgba(230,225,211,0.55);
  text-transform: uppercase;
}
.sheet__slot-cell {
  width: 64px;
  height: 64px;
}

/* ---------- Stats ---------- */
.sheet__avatar {
  width: 96px;
  height: 96px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(232,201,119,0.15), rgba(15,14,24,0.9));
  border: 2px solid rgba(180,150,60,0.4);
  color: #e8c977;
}
.sheet__char-name {
  text-align: center;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #e6e1d3;
  margin-top: 4px;
}
.sheet__stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  margin-top: 8px;
}
.sheet__stat {
  display: flex;
  justify-content: space-between;
  padding: 6px 10px;
  background: rgba(15,14,24,0.5);
  border: 1px solid rgba(180,150,60,0.2);
  border-radius: 6px;
  font-size: 12px;
}
.sheet__stat-label {
  color: rgba(230,225,211,0.7);
}
.sheet__stat-value {
  color: #e8c977;
  font-weight: 700;
}

/* ---------- Inventario ---------- */
.sheet__inv-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 6px;
  overflow-y: auto;
  max-height: 420px;
  padding: 4px;
}
.sheet__inv-grid > .item-cell {
  width: 100%;
  min-height: 72px;
}
.sheet__inv-empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 24px;
  color: rgba(230,225,211,0.5);
  font-style: italic;
}

/* ---------- Filtros ---------- */
.sheet__filters {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
  padding: 4px 0;
  border-bottom: 1px solid rgba(180,150,60,0.15);
}
.sheet__filter {
  padding: 5px 10px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 1px;
  color: rgba(230,225,211,0.7);
  background: rgba(15,14,24,0.6);
  border: 1px solid rgba(180,150,60,0.25);
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.15s;
}
.sheet__filter:hover {
  color: #e8c977;
  border-color: rgba(232,201,119,0.5);
}
.sheet__filter--active {
  color: #1a1822;
  background: linear-gradient(180deg, #e8c977, #b89947);
  border-color: #e8c977;
  box-shadow: 0 0 8px rgba(232,201,119,0.4);
}

/* ---------- Actions ---------- */
.sheet__actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  padding-top: 8px;
  border-top: 1px solid rgba(180,150,60,0.2);
  margin-top: auto;
}

/* ---------- Responsivo ---------- */
@media (max-width: 900px) {
  .sheet__body {
    grid-template-columns: 1fr;
  }
  .sheet__inv-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* ============================================================
   SHOP COM QUANTIDADE (Bloco 11)
   ============================================================ */
.shop-silver-bar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  background: rgba(20,18,30,0.7);
  border: 1px solid rgba(180,150,60,0.3);
  border-radius: 6px;
  margin-bottom: 8px;
  font-size: 13px;
  color: #e6e1d3;
}
.shop-silver-bar__label b { color: #e8c977; }

.shop-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 12px;
}
.shop-row {
  display: grid;
  grid-template-columns: 90px 1fr;
  gap: 10px;
  padding: 8px;
  background: rgba(25,22,38,0.55);
  border: 1px solid rgba(180,150,60,0.18);
  border-radius: 8px;
  align-items: center;
}
.shop-row__cell {
  width: 80px;
  height: 80px;
}
.shop-row__cell > .item-cell {
  width: 100%;
  height: 100%;
}
.shop-row__ctrl {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.shop-qty {
  display: flex;
  align-items: center;
  gap: 4px;
}
.shop-qty__btn {
  width: 28px;
  height: 28px;
  font-size: 16px;
  font-weight: 700;
  color: #e8c977;
  background: rgba(15,14,24,0.7);
  border: 1px solid rgba(180,150,60,0.35);
  border-radius: 5px;
  cursor: pointer;
  transition: all 0.15s;
}
.shop-qty__btn:hover {
  background: rgba(232,201,119,0.15);
  border-color: #e8c977;
}
.shop-qty__input {
  width: 70px;
  padding: 4px 8px;
  text-align: center;
  font-size: 14px;
  font-weight: 700;
  color: #e8c977;
  background: rgba(15,14,24,0.7);
  border: 1px solid rgba(180,150,60,0.35);
  border-radius: 5px;
}
.shop-qty__input:focus {
  outline: none;
  border-color: #e8c977;
  box-shadow: 0 0 6px rgba(232,201,119,0.4);
}

.shop-quick {
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}
.shop-quick__btn {
  padding: 3px 9px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.5px;
  color: rgba(230,225,211,0.7);
  background: rgba(15,14,24,0.6);
  border: 1px solid rgba(180,150,60,0.25);
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.15s;
}
.shop-quick__btn:hover {
  color: #e8c977;
  border-color: rgba(232,201,119,0.5);
}
.shop-quick__btn--active {
  color: #1a1822;
  background: linear-gradient(180deg, #e8c977, #b89947);
  border-color: #e8c977;
}

.shop-row__total {
  font-size: 13px;
  color: #e6e1d3;
}
