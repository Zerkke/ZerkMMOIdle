}
.bar--enemy .bar__fill, .bar[data-kind="enemy"] .bar__fill {
  background: linear-gradient(180deg, #d84848 0%, #7a1f1f 100%) !important;
}
.bar__head {
  padding: 4px 10px !important;
  font-size: 11px !important;
  color: rgba(230,225,211,0.85);
  letter-spacing: 0.5px;
}
.bar__value { color: #e8c977 !important; font-weight: 700; }

/* ---- Botoes globalmente ---- */
button, .action-button {
  padding: 8px 16px !important;
  font-size: 12px !important;
  font-weight: 700 !important;
  letter-spacing: 0.8px !important;
  color: #e6e1d3 !important;
  background: linear-gradient(180deg, rgba(40,32,60,0.9), rgba(20,18,30,0.95)) !important;
  border: 1px solid rgba(180,150,60,0.4) !important;
  border-radius: 7px !important;
  cursor: pointer;
  transition: all 0.15s !important;
  text-transform: uppercase;
}
button:not(:disabled):hover {
  color: #e8c977 !important;
  border-color: #e8c977 !important;
  box-shadow: 0 0 14px rgba(232,201,119,0.4) !important;
  transform: translateY(-1px);
}
button:disabled {
  opacity: 0.4 !important;
  cursor: not-allowed !important;
  filter: grayscale(0.6);
}
button.primary, button[data-variant="primary"], .action-button--primary {
  background: linear-gradient(180deg, #e8c977 0%, #b89947 100%) !important;
  color: #1a1822 !important;
  border-color: #e8c977 !important;
  text-shadow: none !important;
}
button.primary:not(:disabled):hover {
  box-shadow: 0 0 22px rgba(232,201,119,0.7) !important;
}

/* ---- Persistencia (guardar/carregar no fundo) ---- */
.persistence-controls, .panel-content > div:last-child button {
  font-size: 11px !important;
  padding: 6px 12px !important;
}

/* ---- Consistencia de espacos ---- */
.panel-content > * + * { margin-top: 12px; }
.panel-content .muted, p.muted {
  color: rgba(230,225,211,0.55) !important;
  font-size: 12px;
  font-style: italic;
  letter-spacing: 0.3px;
}

/* ---- Tabs internas (aba Inventario dentro da Ficha, etc) ---- */
.tabs-inline, .subtabs {
  display: flex;
  gap: 4px;
  padding: 6px 0;
  border-bottom: 1px solid rgba(180,150,60,0.2);
  margin-bottom: 12px;
}
.tabs-inline button, .subtabs button {
  border: none !important;
  border-radius: 6px 6px 0 0 !important;
  border-bottom: 2px solid transparent !important;
  background: transparent !important;
  padding: 8px 16px !important;
  font-size: 11px !important;
  letter-spacing: 1px !important;
}
.tabs-inline button.active, .subtabs button.active {
  color: #e8c977 !important;
  border-bottom-color: #e8c977 !important;
  text-shadow: 0 0 8px rgba(232,201,119,0.5);
}

/* ===== CHARACTER SHEET v2 (Bloco 16) ===== */
.char-body {
  display: grid;
  grid-template-columns: 1fr 1.2fr 1fr;
  gap: 14px;
  margin-top: 12px;
}
.char-col { display: flex; flex-direction: column; gap: 10px; }

/* --- Portrait --- */
.char-portrait {
  position: relative;
  width: 100%;
  aspect-ratio: 3 / 4;
  max-height: 340px;
  background:
    radial-gradient(ellipse at 50% 70%, rgba(232,201,119,0.12), transparent 60%),
    linear-gradient(180deg, rgba(40,32,60,0.85), rgba(15,14,24,0.95));
  border: 1.5px solid rgba(180,150,60,0.5);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 30px rgba(0,0,0,0.6), 0 4px 20px rgba(0,0,0,0.5);
}
.char-portrait::before, .char-portrait::after {
  content: "";
  position: absolute;
  width: 24px;
  height: 24px;
  border: 2px solid var(--zk-gold-2, #b89947);
  pointer-events: none;
}
.char-portrait::before { top: 6px; left: 6px; border-right: none; border-bottom: none; border-top-left-radius: 8px; }
.char-portrait::after { bottom: 6px; right: 6px; border-left: none; border-top: none; border-bottom-right-radius: 8px; }
.char-portrait__avatar {
  color: rgba(232,201,119,0.55);
  filter: drop-shadow(0 0 20px rgba(232,201,119,0.35));
}
.char-portrait__name {
  text-align: center;
  font-size: 18px;
  font-weight: 800;
  letter-spacing: 2px;
  color: #e8c977;
  text-shadow: 0 0 12px rgba(232,201,119,0.5);
  text-transform: uppercase;
  margin-top: 8px;
}
.char-portrait__class {
  text-align: center;
  font-size: 12px;
  color: rgba(230,225,211,0.65);
  font-style: italic;
}
.char-portrait__level {
  text-align: center;
  padding: 6px 12px;
  background: linear-gradient(180deg, #e8c977, #b89947);
  color: #1a1822;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 2px;
  margin-top: 4px;
  box-shadow: 0 0 14px rgba(232,201,119,0.4);
}
.char-portrait__xp-bar {
  width: 100%;
  height: 14px;
  background: rgba(5,4,10,0.85);
  border: 1px solid rgba(180,150,60,0.4);
  border-radius: 8px;
  overflow: hidden;
  margin-top: 6px;
  box-shadow: inset 0 2px 4px rgba(0,0,0,0.6);
}
.char-portrait__xp-fill {
  height: 100%;
  background: linear-gradient(90deg, #b89947, #e8c977, #fff3c4);
  box-shadow: inset 0 0 10px rgba(255,255,255,0.4), 0 0 12px rgba(232,201,119,0.6);
  transition: width 0.4s ease-out;
}
.char-portrait__xp-text {
  text-align: center;
  font-size: 11px;
  color: rgba(230,225,211,0.7);
  letter-spacing: 0.5px;
}

/* --- Section titles internos --- */
.char-section-title {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 4px;
  color: #e8c977;
  text-shadow: 0 0 10px rgba(232,201,119,0.45);
  padding: 10px 0 6px;
  margin: 4px 0 6px;
  border-bottom: 1px solid rgba(180,150,60,0.22);
  text-transform: uppercase;
  text-align: center;
}

/* --- Attribute cards --- */
.char-attr-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.char-attr-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 12px 8px 8px;
  background: linear-gradient(180deg, rgba(40,32,60,0.8), rgba(20,18,30,0.9));
  border: 1.5px solid color-mix(in srgb, var(--attr-color) 50%, transparent);
  border-radius: 10px;
  box-shadow: inset 0 0 20px color-mix(in srgb, var(--attr-color) 15%, transparent);
  transition: all 0.15s;
}
.char-attr-card:hover {
  border-color: var(--attr-color);
  box-shadow: inset 0 0 24px color-mix(in srgb, var(--attr-color) 25%, transparent), 0 0 14px color-mix(in srgb, var(--attr-color) 40%, transparent);
  transform: translateY(-2px);
}
.char-attr-card__icon {
  color: var(--attr-color);
  filter: drop-shadow(0 0 8px var(--attr-color));
}
.char-attr-card__label {
  font-size: 11px;
  letter-spacing: 1.2px;
  color: rgba(230,225,211,0.75);
  text-transform: uppercase;
  font-weight: 600;
}
.char-attr-card__value {
  font-size: 22px;
  font-weight: 800;
  color: var(--attr-color);
  text-shadow: 0 0 10px color-mix(in srgb, var(--attr-color) 60%, transparent);
  line-height: 1;
}
.char-attr-card__meta {
  font-size: 10px;
  color: rgba(230,225,211,0.5);
  letter-spacing: 0.3px;
}

/* --- Info lines --- */
.char-info-grid {
  display: flex;
  flex-direction: column;
  background: rgba(15,14,24,0.5);
  border: 1px solid rgba(180,150,60,0.2);
  border-radius: 10px;
  padding: 4px 14px;
}
.char-info-line {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px dotted rgba(180,150,60,0.18);
  font-size: 13px;
}
.char-info-line:last-child { border-bottom: none; }
.char-info-line__label { color: rgba(230,225,211,0.7); letter-spacing: 0.5px; }
.char-info-line__value {
  color: #e8c977;
  font-weight: 700;
  text-shadow: 0 0 6px rgba(232,201,119,0.35);
}

/* --- Power cards --- */
.char-power-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}
.char-power-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 14px 8px;
  background: linear-gradient(180deg, rgba(40,32,60,0.85), rgba(15,14,24,0.95));
  border: 1.5px solid color-mix(in srgb, var(--power-color) 55%, transparent);
  border-radius: 12px;
  box-shadow: inset 0 0 24px color-mix(in srgb, var(--power-color) 18%, transparent);
  transition: all 0.15s;
}
.char-power-card:hover {
  transform: translateY(-2px);
  box-shadow: inset 0 0 30px color-mix(in srgb, var(--power-color) 28%, transparent), 0 0 18px color-mix(in srgb, var(--power-color) 45%, transparent);
}
.char-power-card__icon {
  color: var(--power-color);
  filter: drop-shadow(0 0 10px var(--power-color));
}
.char-power-card__label {
  font-size: 11px;
  letter-spacing: 2px;
  color: rgba(230,225,211,0.7);
  font-weight: 700;
  text-transform: uppercase;
}
.char-power-card__value {
  font-size: 30px;
  font-weight: 900;
  color: var(--power-color);
  text-shadow: 0 0 14px color-mix(in srgb, var(--power-color) 65%, transparent);
  line-height: 1;
}

/* --- Stats --- */
.char-stats-grid {
  display: flex;
  flex-direction: column;
  background: rgba(15,14,24,0.5);
  border: 1px solid rgba(180,150,60,0.2);
  border-radius: 10px;
  padding: 4px 12px;
}
.char-stat-line {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 0;
  border-bottom: 1px dotted rgba(180,150,60,0.18);
  font-size: 13px;
}
.char-stat-line:last-child { border-bottom: none; }
.char-stat-line__icon {
  color: var(--stat-color);
  filter: drop-shadow(0 0 6px var(--stat-color));
  display: flex;
  align-items: center;
}
.char-stat-line__label {
  flex: 1;
  color: rgba(230,225,211,0.75);
  letter-spacing: 0.4px;
}
.char-stat-line__value {
  color: var(--stat-color);
  font-weight: 800;
  text-shadow: 0 0 8px color-mix(in srgb, var(--stat-color) 55%, transparent);
}

@media (max-width: 1000px) {
  .char-body { grid-template-columns: 1fr; }
}
